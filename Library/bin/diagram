#!/usr/bin/env python3
"""dev diagram helpers using an isolated Python; source clone remains unchanged."""
import json
import os
from pathlib import Path
import subprocess
import sys

library = Path(__file__).resolve().parents[1]
repo = library / 'diagram-design'
python = library / '.runtime/diagram-tools' / ('Scripts/python.exe' if os.name == 'nt' else 'bin/python')
args = sys.argv[1:]
if not args or args[0] in ('--help', '-h'):
    print('diagram doctor | mermaid SOURCE | drawio SOURCE | skill | profile')
    raise SystemExit(0)
if args == ['skill']:
    print(repo / 'skills/diagram-design/SKILL.md')
    raise SystemExit(0)
if args == ['profile']:
    print(library / 'profiles/house.md')
    raise SystemExit(0)
if (args == ['doctor'] or (len(args) == 2 and args[0] in ('mermaid', 'drawio'))) and not python.is_file():
    print('diagram: no runtime at %s; run python3 %s --install'
          % (python.as_posix(), (library / 'knowledge-tools-sync.py').as_posix()))
    raise SystemExit(2)
if args == ['doctor']:
    # Upstream probes playwright.__version__, which is absent even on valid installs.
    # Prove the actual version, launch and rendering instead of accepting that false warning.
    probe = """
import importlib.metadata,json,sys
from playwright.sync_api import sync_playwright
with sync_playwright() as p:
    browser=p.chromium.launch(headless=True)
    page=browser.new_page();page.set_content('<svg width="100" height="40"><text x="5" y="25">dev</text></svg>')
    assert page.locator('svg').screenshot().startswith(b'\\x89PNG')
    browser.close()
print(json.dumps({'python':sys.version.split()[0],'playwright':importlib.metadata.version('playwright'),'chromium_launch':True,'svg_png_render':True}))
"""
    raise SystemExit(subprocess.call([str(python), '-c', probe]))
if len(args) == 2 and args[0] in ('mermaid', 'drawio'):
    script = repo / 'skills/diagram-design/scripts' / (args[0] + '_extract.py')
    raise SystemExit(subprocess.call([str(python), str(script), str(Path(args[1]).resolve())]))
raise SystemExit('Use diagram --help')
