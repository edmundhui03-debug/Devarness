#!/usr/bin/env python3
"""Run the pinned local Understand-Anything helpers. No model or commit hooks."""
import os
from pathlib import Path
import subprocess
import sys

library = Path(__file__).resolve().parents[1]
pin = next(line.split('\t')[2] for line in (library / 'repos.txt').read_text().splitlines()
           if line.startswith('Library/Understand-Anything\t'))
plugin = library / '.runtime/understand-anything' / pin / 'understand-anything-plugin'
args = sys.argv[1:]
if not args or args[0] in ('--help', '-h'):
    print('understand root | scan PROJECT OUTPUT.json | dashboard PROJECT | merge PROJECT | python')
    print('For semantic analysis: ask either agent to use the understand skill on a named project.')
    print("merge runs the skill's merge-batch-graphs.py with an interpreter >= 3.10; python prints that interpreter.")
    raise SystemExit(0)
# The skill's merge-batch-graphs.py uses `int | None` and needs Python >= 3.10.
# This machine's `python3` is Apple's 3.9.6, so a session following the skill
# literally fails at the merge. Resolve a capable interpreter here, once, so
# nobody has to know the path: the uv-managed CPython that env_check.sh also
# names for kicad-happy, then any other uv CPython >= 3.10, then sys.executable
# if it qualifies.
def modern_python():
    candidates = []
    uv = Path.home() / '.local/share/uv/python'
    for pattern in ('cpython-3.12-*/bin/python3.12', 'cpython-3.13-*/bin/python3.13',
                    'cpython-3.11-*/bin/python3.11', 'cpython-3.10-*/bin/python3.10'):
        candidates += sorted(uv.glob(pattern), reverse=True)
    if sys.version_info >= (3, 10):
        candidates.append(Path(sys.executable))
    for c in candidates:
        if c.is_file() and os.access(c, os.X_OK):
            return c
    raise SystemExit('understand: no Python >= 3.10 found; install one with `uv python install 3.12`')
if args == ['python']:
    print(modern_python())
    raise SystemExit(0)
if args[0] == 'merge' and len(args) == 2:
    raise SystemExit(subprocess.call([str(modern_python()),
        str(plugin / 'skills/understand/merge-batch-graphs.py'), str(Path(args[1]).resolve())]))
if args == ['root']:
    print(plugin)
    raise SystemExit(0)
if args[0] == 'scan' and len(args) == 3:
    command = ['node', str(plugin / 'skills/understand/scan-project.mjs'),
               str(Path(args[1]).resolve()), str(Path(args[2]).resolve()), '--exclude-analysis-data']
elif args[0] == 'dashboard' and len(args) == 2:
    project = Path(args[1]).resolve()
    data = project / ('.understand-anything' if (project / '.understand-anything').is_dir() else '.ua')
    if not (data / 'knowledge-graph.json').is_file():
        raise SystemExit('No knowledge graph exists for this project. Run the understand skill first.')
    command = ['node', str(plugin / 'packages/viewer/bin/viewer.mjs'), str(project)]
else:
    raise SystemExit('Use understand --help')
raise SystemExit(subprocess.call(command))
