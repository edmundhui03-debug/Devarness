#!/usr/bin/env bash
set -eu
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  case "$src" in /*) ;; *) src="$dir/$src" ;; esac
done
ROOT="$(cd "$(dirname "$src")/../.." && pwd)"
python3 "$ROOT/tools/session.py" --check --text
cd "$ROOT"
exec codex "$@"
