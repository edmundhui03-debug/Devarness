#!/usr/bin/env python3
"""dev-check — run every dev checker and both test trees, and print one table.

  dev-check [--fast] [--only NAME ...] [--json]
  dev-check --daily | --install-daily | --uninstall-daily

Two channels' talks made the same point on 2026-09-18: an agent cannot know it
has finished if it cannot measure that cheaply, from one obvious entry point.
The old workspace had eight checkers and no single way to run them; this is
that way.

Each row is a gate or information. A gate that fails, errors or outlives its
bound fails the run; information never does, however loud it is — the md-format
backlog is reported here and is not a failure, because the house format is not
retroactive. --fast skips the rows marked slow, the three test suites over
twenty seconds; --only names rows explicitly and so wins over it. Exit 0 when every gate passed, 1 otherwise, 2 on a usage
error. Read-only: nothing here writes to the repository, and start-check runs with
--check.

The full check also runs every day at 05:00, as the task DEVARNESS_check_daily
(owner decision 2026-09-24; a launchd job on the Mac since 2026-09-26):
--install-daily registers it and --uninstall-daily removes it. --daily is what
the task runs: the day's table goes to .claude/hooks/dev-check-daily/, with
latest.json for the session banner.

Standard-library Python 3.9 or later. No network of its own.
"""
from __future__ import annotations

import argparse
from datetime import datetime
import json
import os
import plistlib
from pathlib import Path
import re
import shutil
import subprocess
import sys
import time
from typing import NamedTuple

ROOT = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(ROOT / "Library"))
import common  # noqa: E402
GATE, INFO = "gate", "info"
DAILY = ROOT / ".claude/hooks/dev-check-daily"   # gitignored, per machine
TASK = "DEVARNESS_check_daily"
KEEP = 30                                  # days of logs


class UsageError(Exception):
    pass


class Check(NamedTuple):
    name: str
    kind: str
    argv: list        # relative to the dev root; the launcher is resolved by command_for
    bound: int        # seconds
    slow: bool
    tolerate: tuple   # exit codes reported as information rather than failure


class Result(NamedTuple):
    name: str
    kind: str
    status: str       # pass, FAIL, TIMEOUT, ERROR, info, SKIP
    seconds: float
    detail: str


PLAN = (
