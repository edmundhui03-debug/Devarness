* text=auto eol=lf

# Shell, python and JS must be LF on every platform, or Git for Windows checks
# them out with CRLF and every script dies with "bad interpreter". This is not
# dependent on the user's global line-ending configuration.
*.sh  text eol=lf
*.py  text eol=lf
*.js  text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
# The manifests bootstrap.sh reads with bash: a CR would end up in a pin.
Library/*.txt text eol=lf

# Extensionless launchers in Library/bin. *.sh does NOT catch these, and i18n
# is what enforces the bilingual house rule.
# A pattern with no slash matches the basename at any depth. gitattributes has
# no way to escape spaces in a pattern, so match the basename.
# Library/tests/test_line_endings.py keeps this list and Library/bin in step,
# both ways: agent-memory and new-device were once added and missed here, and
# four dropped tools once kept their lines.
