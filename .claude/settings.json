{
  "autoCompactWindow": 300000,
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/session.py\" --hook",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/session.py\" --prompt-hook",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_git_amend.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_heredoc.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_vendor_code.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/post_edit_check.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "claudeMdExcludes": [
    "**/Harness/reverse-skill/**",
    "**/Harness/rea/**",
    "**/Harness/docling/**",
    "**/Harness/playwright-cli/**",
    "**/Harness/ECC/**",
    "**/Harness/claude-scholar/**",
    "**/Harness/codex-plugin-cc/**",
    "**/Harness/cship/**",
    "**/Harness/markitdown/**",
    "**/Harness/prompt-master/**",
    "**/Harness/skills/**",
    "**/Harness/Understand-Anything/**",
    "**/Harness/diagram-design/**",
    "**/Harness/learn-claude-code/**",
    "**/Harness/i-have-adhd/**",
    "**/Harness/pcb/KiCAD-MCP-Server/**",
    "**/Harness/pcb/kicad-happy/**",
    "**/Harness/pcb/pcb-designer-ai-agent/**",
    "**/Harness/pcb/Konnect/**",
    "**/Harness/archify/**",
    "**/Harness/ponytail/**",
    "**/Harness/laya/**",
    "**/Harness/karpathy-skills/**",
    "**/Harness/anthropic-design/**",
    "**/Harness/vercel-skills/**",
    "**/Harness/harness2/**",
    "**/Harness/pcb/heypcb-mcp/**",
    "**/Harness/pstack/**",
    "**/Harness/superpowers/**"
  ]
}
