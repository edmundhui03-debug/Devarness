#!/usr/bin/env python3
"""Pinned shared Playwright CLI. Use --agent peter|aster|may to isolate sessions."""
import os
from pathlib import Path
import subprocess
import sys

library = Path(__file__).resolve().parents[1]
args = sys.argv[1:]
if args in (['-h'], ['--help']):
    print(__doc__ + '\nUsage: browser --agent peter|aster|may COMMAND [ARGS]; use --help as COMMAND')
    raise SystemExit(0)
if len(args) < 2 or args[0] != '--agent' or args[1] not in ('peter', 'aster', 'may'):
    raise SystemExit('Usage: browser --agent peter|aster|may COMMAND [ARGS]; use --help as COMMAND')
agent, args = args[1], args[2:]
if any(a.startswith('-s=') or a.startswith('--session') for a in args):
    raise SystemExit('Session selection is owned by --agent.')
if any(a in ('kill-all', 'close-all') for a in args):
    raise SystemExit('Use close for your own session.')
cli = library / '.runtime/playwright-cli/node_modules/@playwright/cli/playwright-cli.js'
if not cli.is_file():
    raise SystemExit('Run python3 %s --install' % (library / 'setup-browser-docs.py').as_posix())
raise SystemExit(subprocess.call(['node', str(cli), '-s=' + agent, *args]))
