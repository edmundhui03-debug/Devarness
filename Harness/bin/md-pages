#!/usr/bin/env bash
# md-pages — convert a document to Markdown with page markers.
#
# Why this exists: `markitdown` produces one flat stream with no page
# boundaries, but a datasheet finding has to cite a page ("SOA curve, p.4") or
# nobody can check it. The `=====PAGE N=====` markers keep findings locatable
# in the original document.
#
# PDFs are split per page with pdfplumber from the selected markitdown
# virtualenv; check that installation before use. Anything that is
# not a PDF is handed to plain markitdown, which has no pages to mark anyway.
#
#   md-pages input.pdf              -> stdout
#   md-pages input.pdf -o out.md    -> file
#   md-pages *.pdf --outdir text/   -> one .md per input, named after it
#
set -uo pipefail

TOOL_PY="$HOME/.local/share/uv/tools/markitdown/bin/python"
# uv keeps tools under %APPDATA%\uv\tools on Windows, with Scripts/python.exe in
# each environment. Ask uv for its tool directory rather than assume this layout.
if [ ! -x "$TOOL_PY" ] && command -v uv >/dev/null 2>&1; then
  UV_TOOLS="$(uv tool dir 2>/dev/null)"
  [ -n "$UV_TOOLS" ] && command -v cygpath >/dev/null 2>&1 && UV_TOOLS="$(cygpath -u "$UV_TOOLS")"
  [ -n "$UV_TOOLS" ] && [ -x "$UV_TOOLS/markitdown/Scripts/python.exe" ] && TOOL_PY="$UV_TOOLS/markitdown/Scripts/python.exe"
fi
MARKITDOWN="$HOME/.local/bin/markitdown"

if [ ! -x "$TOOL_PY" ]; then
  echo "md-pages: markitdown is not installed (expected $TOOL_PY)" >&2
  echo "  fix: uv tool install 'markitdown[all]'" >&2
  exit 1
fi

OUT=""; OUTDIR=""; INPUTS=()
while [ $# -gt 0 ]; do
  case "$1" in
    -o|--output) OUT="${2:-}"; shift 2 ;;
    --outdir)    OUTDIR="${2:-}"; shift 2 ;;
    -h|--help)   sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*)          echo "md-pages: unknown option $1" >&2; exit 2 ;;
    *)           INPUTS+=("$1"); shift ;;
  esac
done

if [ "${#INPUTS[@]}" -eq 0 ]; then
  echo "md-pages: no input files. Try: md-pages --help" >&2
  exit 2
fi
if [ -n "$OUT" ] && [ "${#INPUTS[@]}" -gt 1 ]; then
  echo "md-pages: -o takes one input; use --outdir for several" >&2
  exit 2
fi
[ -n "$OUTDIR" ] && mkdir -p "$OUTDIR"

convert_one() {
  local f="$1" dest="$2"
  if [ ! -f "$f" ]; then echo "md-pages: no such file: $f" >&2; return 1; fi

  case "${f##*.}" in
    pdf|PDF)
      if [ -n "$dest" ]; then
        "$TOOL_PY" - "$f" > "$dest" <<'PY'
import sys, warnings, logging
warnings.filterwarnings("ignore")
# pdfminer logs a FontBBox complaint per malformed font descriptor. Real
# datasheets trip it constantly and it says nothing about the extraction.
for _n in ("pdfminer", "pdfplumber", "pdfminer.pdfinterp", "pdfminer.pdffont"):
    logging.getLogger(_n).setLevel(logging.ERROR)
import pdfplumber
with pdfplumber.open(sys.argv[1]) as pdf:
    for i, page in enumerate(pdf.pages, 1):
        print(f"\n=====PAGE {i}=====")
        print((page.extract_text() or "").strip())
        for table in page.extract_tables() or []:
            rows = [[(c or "").replace("|", "\\|").strip() for c in row] for row in table]
            rows = [r for r in rows if any(r)]
            if len(rows) < 2:
                continue
            print()
            print("| " + " | ".join(rows[0]) + " |")
            print("|" + "|".join(" --- " for _ in rows[0]) + "|")
            for r in rows[1:]:
                print("| " + " | ".join(r) + " |")
PY
      else
        "$TOOL_PY" - "$f" <<'PY'
import sys, warnings, logging
warnings.filterwarnings("ignore")
# pdfminer logs a FontBBox complaint per malformed font descriptor. Real
# datasheets trip it constantly and it says nothing about the extraction.
for _n in ("pdfminer", "pdfplumber", "pdfminer.pdfinterp", "pdfminer.pdffont"):
    logging.getLogger(_n).setLevel(logging.ERROR)
import pdfplumber
with pdfplumber.open(sys.argv[1]) as pdf:
    for i, page in enumerate(pdf.pages, 1):
        print(f"\n=====PAGE {i}=====")
        print((page.extract_text() or "").strip())
        for table in page.extract_tables() or []:
            rows = [[(c or "").replace("|", "\\|").strip() for c in row] for row in table]
            rows = [r for r in rows if any(r)]
            if len(rows) < 2:
                continue
            print()
            print("| " + " | ".join(rows[0]) + " |")
            print("|" + "|".join(" --- " for _ in rows[0]) + "|")
            for r in rows[1:]:
                print("| " + " | ".join(r) + " |")
PY
      fi
      ;;
    *)
      if [ -n "$dest" ]; then "$MARKITDOWN" "$f" -o "$dest"; else "$MARKITDOWN" "$f"; fi
      ;;
  esac
}

status=0
for f in "${INPUTS[@]}"; do
  dest="$OUT"
  if [ -n "$OUTDIR" ]; then
    base="$(basename "$f")"
    dest="$OUTDIR/${base%.*}.md"
  fi
  convert_one "$f" "$dest" || status=1
  if [ -n "$dest" ] && [ -f "$dest" ]; then
    words=$(wc -w < "$dest" | tr -d ' ')
    if [ "$words" -lt 20 ]; then
      echo "md-pages: $(basename "$f") produced $words words — probably a scan with no text layer" >&2
    fi
    echo "$dest"
  fi
done
exit $status
