#!/usr/bin/env python3
"""task-recall — name a task and get what is done, what is open, and the next step.

  task-recall <words...>          the box for what you named
  task-recall --prompt <words>    the next step, ready to paste at an agent
  task-recall --json <words>      the same, machine-readable
  task-recall --list              the subjects dev can answer about

dev already holds the answer in four places and none of them can be asked by
name: `md-format status` indexes every marked section, plans carry checkboxes,
task records carry rows, and Peter's memory carries the why. This reads all
four and prints one box.

It stores nothing of its own. A second copy of task state is a copy that
drifts, and this workspace has been bitten by that more than once — so the
ledger stays where it is written, in the documents and in git.

The shape follows the memory chapter of bojieli/ai-agent-book (book-en/chapter3, pin dbc046e):
a trajectory that is append-only (git history), an archive that is rewritten
(Peter's memory), and a business state that names the logical stage of a task
(dev's `open`, `fixed`, `blocked`, `partial`, `needs-owner`). What this adds is
the chapter's Level 2 — retrieval across sessions and records — over the
filesystem rather than an embedding store, because dev is already a filesystem
of documents that say where they are up to.

Read-only. Standard-library Python 3.9 or later. No network.
"""
from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import re
import subprocess
import sys
from typing import NamedTuple

ROOT = Path(__file__).resolve().parents[2]
LIVE = ("open", "blocked", "needs-owner", "partial")
WORD = re.compile(r"[a-z0-9]+")
# Words too common in this workspace to carry a match on their own.
COMMON = {"the", "and", "for", "with", "that", "this", "from", "into", "not", "its",
          "was", "are", "has", "have", "md", "claude", "peter", "aster", "setup",
          "doc", "docs", "file", "files", "task", "tasks", "work", "run", "new", "one",
          "two", "all", "any", "out", "off", "own", "use", "used", "get", "got",
          # Asking words and words this workspace says everywhere. "fix" put a PCB
          # Studio handover at the top of "can you fix the typo": every closed
          # section in dev is marked fixed.
          "can", "you", "your", "our", "her", "his", "they", "them", "their", "fix",
          "fixed", "open", "add", "make", "made", "need", "needs", "want", "please",
          "help", "check", "checks", "write", "read", "look", "tell", "show", "now",
          "then", "done", "thing", "things", "way", "ways", "good", "just", "also",
          "very", "more", "most", "some", "here", "there", "what", "when", "where",
          "why", "how", "who", "does", "did", "will", "would", "could", "should",
          "must", "may", "might", "about", "over", "under", "after", "before",
          "still", "only", "even", "much", "many", "few", "less", "else", "same",
          "other", "next", "last", "first", "back", "again", "yet", "than", "been",
          "being", "let", "put", "see", "say", "said", "know", "think", "like"}
# Everything the workspace tracks, so a subject discussed only in a document that
# carries no marked section — the ngspice row in Harness/INSTALL.md — is still a
# candidate. Vendored clones and separate projects are gitignored, so git's own
# list is already the right one; these are the fallback without git.
EXTRA = ("Setup/superpowers/plans/*.md", "Setup/*TASKS*.md", "Harness/guides/*.md")
CHECKED = re.compile(r"^\s*[-*] \[([ xX])\]", re.M)   # re.M, or ^ matches once per file
TITLE = re.compile(r"^#\s+(.+?)\s*#*$")
FROZEN = re.compile(r"(^|/)Setup/handoff/")
# What it takes for a sentence to NAME a subject, which is a harder question than
# sharing words with it. "the sync of the device" still reads as one name, so two
# words count as said together when at most NEAR words apart; and a word that a
# quarter of all documents use — design, review, start — says nothing about any one
# of them. In a workspace of a dozen documents "a quarter" is three, so there is a
# floor under it.
NEAR = 3
UBIQUITOUS = 0.25
UBIQUITOUS_FLOOR = 4


class Section(NamedTuple):
    status: str
    line: int
    heading: str


class Subject(NamedTuple):
    file: str
    title: str
    score: float
    strong: float     # the part from the path and the headings, not the prose
    sections: list
    memories: list

    @property
    def open(self):
        return [s for s in self.sections if s.status in LIVE]

    @property
    def done(self):
        return [s for s in self.sections if s.status not in LIVE]


def stem(word: str) -> str:
    """A plural folded to its singular, and nothing cleverer.

    "pages" did not match "page", so CLAUDE.md's own bilingual rule was
    invisible to a search for "bilingual pages". The endings excluded here are
    the ones that would mangle a word rather than fold it: status, analysis,
    across, chaos.
    """
    if len(word) > 4 and word.endswith("s") and not word.endswith(("ss", "us", "is", "as", "os")):
        return word[:-1]
    return word


def words(text: str) -> set:
    # Filter both forms: "looks" must not reintroduce the common word "look".
    return {stem(w) for w in WORD.findall(text.lower())
            if len(w) > 2 and w not in COMMON and stem(w) not in COMMON}


def read(path: Path) -> str:
    try:
        return path.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return ""


def title_of_text(text: str, relative: str) -> str:
    for line in text.splitlines()[:40]:
        m = TITLE.match(line)
        if m:
            return m.group(1)
    return relative


def title_of(root: Path, relative: str) -> str:
    return title_of_text(read(root / relative), relative)


MEMO = Path(".claude") / "hooks" / "task-recall.memo.json"     # per device, gitignored, rebuilt at will


def status_index(root: Path, given: Path = None, memo: Path = None):
    """md-format's own index, asked for as JSON so there is one parser of the format.

    With a memo, md-format does not re-read a file that has not changed. Only the prompt
    hook asks for one: it runs on every prompt, and a question typed at task-recall can
    afford the two seconds and should stay read-only.
    """
    if given:
        try:
            return json.loads(read(given))
        except ValueError:
            return {"sections": []}
    launcher = root / "Harness" / "bin" / "md-format"
    argv = ([sys.executable, str(launcher)] if launcher.is_file() else ["md-format"])
    try:
        extra = ["--memo", str(memo)] if memo else []
        done = subprocess.run(argv + ["status", "--json"] + extra, cwd=str(root), capture_output=True,
                              text=True, encoding="utf-8", errors="replace", timeout=120,
                              stdin=subprocess.DEVNULL,
                              env=dict(os.environ, PYTHONIOENCODING="utf-8"))
        return json.loads(done.stdout)
    except (OSError, ValueError, subprocess.SubprocessError):
        return {"sections": []}


def memories(folder: Path):
    """Peter's memory files as (name, description, searchable text)."""
    found = []
    if not folder or not folder.is_dir():
        return found
    for path in sorted(folder.glob("*.md")):
        if path.name == "MEMORY.md":
            continue
        text = read(path)
        description = ""
        for line in text.splitlines()[:12]:
            if line.startswith("description:"):
                description = line.split(":", 1)[1].strip().strip('"')
                break
        found.append((path.stem, description, text))
    return found


def find(query, root: Path, status: dict, memory: Path = None, limit: int = 4):
    """Every subject the words could mean, best first."""
    wanted = words(" ".join(query))
    if not wanted:
        return []
    grouped = {}
    for row in status.get("sections", []):
        grouped.setdefault(row["file"], []).append(
            Section(row["status"], row["line"], row["heading"]))
    for relative in status.get("files") or tracked_markdown(root):
        grouped.setdefault(relative, [])

    remembered = memories(memory)
    subjects = []
    for relative, sections in grouped.items():
        body = read(root / relative)
        title = title_of_text(body, relative)
        path_words = words(relative.replace("/", " ").replace("-", " ").replace("_", " "))
        head_words = words(" ".join(s.heading for s in sections) + " " + title)
        # A path names the subject, a heading mentions it, a body merely discusses
        # it — the ngspice install is a table row in INSTALL.md and a line in
        # TOOLS.md, and scoring paths and headings alone could not see it at all.
        lower = body.lower()
        said = sum(lower.count(w) for w in wanted)
        # Frequency, not mere presence: Harness/INSTALL.md says ngspice 21 times and a
        # review that mentions it once said it once, and a flat body score made
        # those equal, so the tie-break — most open work — decided instead. Capped,
        # so a chatty document can never outrank a path that names the subject.
        strong = 2.0 * len(wanted & path_words) + 1.0 * len(wanted & head_words)
        score = strong + 0.5 * len(wanted & words(body)) + min(0.1 * said, 1.4)
        if FROZEN.search(relative):
            strong *= 0.5
            # A dated snapshot of Peter's memory. task-recall reads the live folder
            # already, so the copy should never outrank the document it was cut
            # from — it answered "bilingual pages" ahead of the live rule.
            score *= 0.5
        if not score:
            continue
        # Ranked, not merely matched: one shared word pulls every PCB memory into
        # a question about one PCB project, and a box of near-misses is noise.
        scored = [(len(wanted & words(name + " " + description)), name, description)
                  for name, description, _ in remembered]
        best = max([n for n, _, _ in scored] or [0])
        near = [(name, description) for n, name, description in sorted(scored, reverse=True)
                if n and n >= best]
        subjects.append(Subject(relative, title, score, strong, sections, near))
    subjects.sort(key=lambda s: (-s.score, -len(s.open), s.file))
    return subjects[:limit]


def said_together(text: str) -> set:
    """Pairs of content words that stand within NEAR words of each other."""
    kept = [(position, stem(raw)) for position, raw in enumerate(WORD.findall(text.lower()))
            if len(raw) > 2 and raw not in COMMON and stem(raw) not in COMMON]
    return {frozenset((a, b)) for i, (at, a) in enumerate(kept)
            for to, b in kept[i + 1:] if a != b and to - at <= NEAR}


def names_of(relative: str, title: str, sections) -> list:
    """Every name a subject answers to, each on its own: a folder, the file, the title, a heading.

    Kept apart on purpose. One record with 32 marked sections has 128 heading
    words, and a long prompt found five of them — one per heading, which is what
    chance looks like. A name is where the words stand together.
    """
    return ([(3, words(part)) for part in relative.split("/")] + [(2, words(title))]
            + [(1, words(s.heading)) for s in sections])


def uses(word: str, lower: str) -> bool:
    """Whether a lowered text uses the word, plural or not — stem()'s rule, without tokenising."""
    return word in lower and re.search(
        r"(?<![a-z0-9])%ss?(?![a-z0-9])" % re.escape(word), lower) is not None


def named(query, root: Path, status: dict, memory: Path = None):
    """The one subject these words NAME, or None. The prompt hook's gate.

    find() ranks by shared words: right for a question typed at task-recall, wrong for
    a sentence typed at an agent. On 2026-09-22, the day after Research, DATASET and
    SAMPLE_FIRMWARE tripled the documents, 19 of 28 ordinary prompts shared a word with some
    path — "test" with UNIT_TEST_COVERAGE.md, "rest" with a REST plan, "bugs" with
    a web-bugs plan — and one shared word was enough to speak. No count of shared
    words can tell a name from a sentence; how rare the word is cannot either,
    because "umbrella" and "album" are rarer here than "pcb". What tells them apart
    is that a project is named by words that stand together, in the prompt and in
    the name: "pcb studio", "emergency button", "device sync sheet".

    A single-word name — "pyrosim" — is therefore not recognised. That is the
    price, it is deliberate, and `task-recall pyrosim` is one command away.
    """
    text = " ".join(query)
    pairs = said_together(text)
    if not pairs:
        return None
    grouped = {}
    for row in status.get("sections", []):
        grouped.setdefault(row["file"], []).append(
            Section(row["status"], row["line"], row["heading"]))
    for relative in status.get("files") or tracked_markdown(root):
        grouped.setdefault(relative, [])

    titles = status.get("titles") or {}
    found = []
    for relative, sections in grouped.items():
        title = titles.get(relative) or title_of(root, relative)
        for kind, unit in names_of(relative, title, sections):
            matched = [pair for pair in pairs if pair <= unit]
            if matched:
                found.append((relative, title, sections, kind, matched))
    if not found:
        return None

    # Only now, and only for the few words in play: how many documents use each.
    lowered = [read(root / relative).lower() for relative in grouped]
    at_most = max(UBIQUITOUS_FLOOR, UBIQUITOUS * len(lowered))
    everywhere = {word for word in {w for _, _, _, _, matched in found for pair in matched for w in pair}
                  if sum(1 for lower in lowered if uses(word, lower)) >= at_most}

    best = {}
    for relative, title, sections, kind, matched in found:
        telling = [pair for pair in matched if not pair <= everywhere]
        if not telling:
            continue
        rank = (len({w for pair in telling for w in pair}), kind)
        if relative not in best or rank > best[relative][0]:
            best[relative] = (rank, title, sections)
    if not best:
        return None
    # A dated copy of Peter's memory carries the project's name as its file name, so
    # it would outrank every live record of the project it was cut from. It answers
    # only when nothing live does; the live memory is shown with the box anyway.
    ranked = sorted(best.items(), key=lambda item: (
        bool(FROZEN.search(item[0])), -item[1][0][0], -item[1][0][1],
        -sum(1 for s in item[1][2] if s.status in LIVE), item[0]))
    relative, (rank, title, sections) = ranked[0]
    wanted = words(text)
    scored = [(len(wanted & words(name + " " + description)), name, description)
              for name, description, _ in memories(memory)]
    most = max([n for n, _, _ in scored] or [0])
    near = [(name, description) for n, name, description in sorted(scored, reverse=True)
            if n and n >= most]
    return Subject(relative, title, float(rank[0]), float(rank[0]), sections, near)


def tracked_markdown(root: Path):
    """Every .md dev tracks. Falls back to the plans and task records without git."""
    try:
        done = subprocess.run(["git", "-C", str(root), "ls-files", "*.md"], capture_output=True,
                              text=True, timeout=30, encoding="utf-8", errors="replace",
                              stdin=subprocess.DEVNULL)
        if done.returncode == 0 and done.stdout.strip():
            return [line for line in done.stdout.splitlines() if line.strip()]
    except (OSError, subprocess.SubprocessError):
        pass
    found = []
    for pattern in EXTRA:
        found.extend(p.relative_to(root).as_posix() for p in sorted(root.glob(pattern)))
    return found


def checkboxes(root: Path, relative: str):
    marks = CHECKED.findall(read(root / relative))
    return (sum(1 for m in marks if m.lower() == "x"), len(marks)) if marks else None


def touched(root: Path, relative: str, count: int = 3):
    try:
        done = subprocess.run(["git", "-C", str(root), "log", "-%d" % count, "--format=%h %s",
                               "--", relative], capture_output=True, text=True, timeout=20,
                              encoding="utf-8", errors="replace", stdin=subprocess.DEVNULL)
        return [line for line in done.stdout.splitlines() if line.strip()]
    except (OSError, subprocess.SubprocessError):
        return []


def box(subject: Subject, root: Path, memory: Path = None, commits: bool = True) -> str:
    out = ["%s" % subject.title, "  %s" % subject.file]
    boxes = checkboxes(root, subject.file)
    if boxes:
        out.append("  %d of %d steps ticked" % boxes)
    if subject.done:
        out.append("")
        out.append("DONE")
        for s in subject.done[:6]:
            out.append("  %-12s %s" % (s.status, s.heading))
        if len(subject.done) > 6:
            out.append("  ... %d more" % (len(subject.done) - 6))
    out.append("")
    if subject.open:
        out.append("OPEN")
        for s in subject.open:
            out.append("  %-12s %s" % (s.status, s.heading))
            out.append("               `%s:%d`" % (subject.file, s.line))
    else:
        out.append("OPEN  nothing open here")
    if subject.memories:
        out.append("")
        out.append("MEMORY")
        for name, description in subject.memories[:3]:
            out.append("  %s" % name)
            if description:
                out.append("      %s" % description[:150])
    if commits:
        log = touched(root, subject.file)
        if log:
            out.append("")
            out.append("LAST TOUCHED")
            out.extend("  %s" % line for line in log)
    return "\n".join(out)


def next_prompt(subject: Subject, root: Path) -> str:
    """A next step assembled from the record, not written by a model."""
    boxes = checkboxes(root, subject.file)
    if not subject.open:
        ticked = ("; %d of %d steps are ticked" % boxes) if boxes else ""
        return ("Nothing open in `%s`%s — every marked section there is closed. Read it "
                "before assuming there is nothing left, then tell me what you think the "
                "next step is and why; do not start one without grilling me first."
                % (subject.file, ticked))
    lines = ["Pick up %s (`%s`)." % (subject.title, subject.file), "", "Still open:"]
    for s in subject.open:
        lines.append("  - [%s] %s — `%s:%d`" % (s.status, s.heading, subject.file, s.line))
    if boxes and boxes[0] < boxes[1]:
        lines.append("  - %d of %d steps in that file are still unticked"
                     % (boxes[1] - boxes[0], boxes[1]))
    if subject.memories:
        lines.append("")
        lines.append("Read first: " + ", ".join(name for name, _ in subject.memories[:3])
                     + " in Peter's memory.")
    lines += [
        "",
        "Read the file and the evidence each line cites before proposing anything. "
        "Run grill-first on what you propose and wait for my answer; do not start work "
        "the interview has not settled. When you think it is done, dev-check must be "
        "green and every claim labelled verified, inferred or not checked.",
    ]
    return "\n".join(lines)


def as_json(subjects, root: Path) -> str:
    return json.dumps({"root": str(root), "subjects": [
        {"file": s.file, "title": s.title, "score": s.score, "strong": s.strong,
         "checkboxes": checkboxes(root, s.file),
         "open": [{"status": x.status, "heading": x.heading, "line": x.line} for x in s.open],
         "done": [{"status": x.status, "heading": x.heading, "line": x.line} for x in s.done],
         "memories": [{"name": n, "description": d} for n, d in s.memories]}
        for s in subjects]}, indent=2, ensure_ascii=False)


def default_memory(root: Path) -> Path:
    launcher = root / "Harness" / "bin" / "agent-memory"
    if launcher.is_file():
        try:
            done = subprocess.run([sys.executable, str(launcher), "where"], capture_output=True,
                                  text=True, timeout=30, stdin=subprocess.DEVNULL)
            if done.returncode == 0 and done.stdout.strip():
                return Path(done.stdout.strip())
        except (OSError, subprocess.SubprocessError):
            pass
    return Path()


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(prog="task-recall", description="what is done, what is open, what is next")
    ap.add_argument("words", nargs="*", help="a project, a task, a tool — any words dev would use")
    ap.add_argument("--root", type=Path, default=ROOT)
    ap.add_argument("--status-json", type=Path, help="read md-format status --json from here")
    ap.add_argument("--memory", type=Path, help="Peter's memory folder")
    ap.add_argument("--prompt", action="store_true", help="print the next step, ready to paste")
    ap.add_argument("--json", action="store_true", help="machine-readable")
    ap.add_argument("--list", action="store_true", help="the subjects dev can answer about")
    ap.add_argument("--limit", type=int, default=4)
    ap.add_argument("--quiet", action="store_true", help="say nothing when nothing matches")
    ap.add_argument("--named", action="store_true",
                    help="answer only when the words NAME a subject — the prompt hook's gate")
    args = ap.parse_args(argv)

    root = args.root.resolve()
    status = status_index(root, args.status_json, memo=(root / MEMO) if args.named else None)
    memory = args.memory if args.memory is not None else default_memory(root)

    if args.list:
        seen = sorted({row["file"] for row in status.get("sections", [])})
        for relative in seen:
            print("%-60s %s" % (relative, title_of(root, relative)))
        print("\n%d documents carry a marked section." % len(seen))
        return 0

    if not args.words:
        ap.error("name a task: task-recall dev workspace")

    if args.named:
        one = named(args.words, root, status, memory)
        subjects = [one] if one else []
    else:
        subjects = find(args.words, root, status, memory, limit=max(1, args.limit))
    if not subjects:
        if not args.quiet:
            print("task-recall: nothing in dev matches %r. Try task-recall --list."
                  % " ".join(args.words))
        return 1

    if args.json:
        print(as_json(subjects, root))
        return 0
    if args.prompt:
        print(next_prompt(subjects[0], root))
        return 0

    print(box(subjects[0], root, memory))
    if len(subjects) > 1:
        print("\nALSO MATCHED")
        for s in subjects[1:]:
            print("  %-58s %d open" % (s.file, len(s.open)))
    print("\nNext step, ready to paste:  task-recall --prompt %s" % " ".join(args.words))
    return 0


if __name__ == "__main__":
    sys.exit(main())
