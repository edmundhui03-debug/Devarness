#!/usr/bin/env python3
"""Install pinned ngspice in the ignored dev runtime, without a package manager.

On macOS it builds the official source release, which needs the Command Line
Tools already installed; X11, readline, OpenMP and OSDI are disabled. On
Windows it installs the official prebuilt release, unpacked with 7-Zip's own
pinned 7zr.exe, and uses its console executable, ngspice_con.exe: the
windowed ngspice.exe exits 0 in batch mode and prints nothing. --check only
probes the local runtime. --install verifies every download against its pin,
installs locally, and creates the user command in ~/.local/bin only if
absent. Reinstall after moving dev: the runtime prefix is absolute.
"""

import argparse
import hashlib
import json
import math
import os
from pathlib import Path
import platform
import re
import shlex
import shutil
import subprocess
import sys
import stat
import tarfile
import tempfile
import time
import urllib.request


VERSION = "47"
SHA256 = "894e649651f1838a14095e5a5439e7d3aa63e87ede14d283173fda4fcdef675f"
SOURCE_URL = ("https://downloads.sourceforge.net/project/ngspice/"
              "ng-spice-rework/47/ngspice-47.tar.gz")
CHECKSUM_URL = ("https://sourceforge.net/projects/ngspice/files/"
                "ng-spice-rework/47/ngspice-47.tar.gz/download")
# Windows: the official prebuilt release (SourceForge publishes its MD5,
# 550f3a5a278ddcb464470878aa173482, which the pinned download matched on
# 2026-09-19), and 7-Zip 26.03's 7zr.exe, whose SHA-256 GitHub publishes.
WINDOWS_URL = ("https://downloads.sourceforge.net/project/ngspice/"
               "ng-spice-rework/47/ngspice-47_64.7z")
WINDOWS_SHA256 = "59225971bd68cdd1199443649aa4615a9e6d684933f205ab49006a3942518f5a"
WINDOWS_CHECKSUM_URL = ("https://sourceforge.net/projects/ngspice/files/"
                        "ng-spice-rework/47/ngspice-47_64.7z/download")
SEVENZR_URL = "https://github.com/ip7z/7zip/releases/download/26.03/7zr.exe"
SEVENZR_SHA256 = "ad4c82fadcbdf93c03b4fc440f300509c7d60c5c2f4d183e35d9d70d6957037d"
ROOT = Path(__file__).resolve().parents[2]
PREFIX = ROOT / "Harness" / ".runtime" / "ngspice" / VERSION
CONFIGURE = ["--with-x=no", "--with-readline=no", "--disable-openmp",
             "--disable-osdi", "--disable-debug"]
NETLIST = """dev ngspice isolated operating-point smoke test
V1 supply 0 DC 10
R1 supply mid 1k
R2 mid 0 1k
.control
op
print v(mid)
quit 0
.endc
.end
"""


def windows():
    return platform.system() == "Windows"


def binary_path():
    """The executable batch runs use, inside the runtime."""
    if windows():
        return PREFIX / "Spice64" / "bin" / "ngspice_con.exe"
    return PREFIX / "bin" / "ngspice"


def pin():
    """What this platform installs from: the source release, or on Windows the prebuilt one."""
    if windows():
        return {"url": WINDOWS_URL, "sha256": WINDOWS_SHA256, "checksum_url": WINDOWS_CHECKSUM_URL,
                "configure_options": None, "unpacked_with": SEVENZR_URL,
                "unpacker_sha256": SEVENZR_SHA256}
    return {"url": SOURCE_URL, "sha256": SHA256, "checksum_url": CHECKSUM_URL,
            "configure_options": CONFIGURE}


def probe(binary):
    """Require the pinned executable to solve a real 10 V equal divider."""
    version = subprocess.run([str(binary), "--version"], check=True,
                             capture_output=True, text=True, timeout=15)
    if not re.search(r"\bngspice-" + VERSION + r"\b", version.stdout):
        raise RuntimeError("Installed executable is not ngspice " + VERSION)
    with tempfile.TemporaryDirectory(prefix="ngspice-probe-") as temp:
        circuit = Path(temp) / "divider.cir"
        circuit.write_text(NETLIST)
        result = subprocess.run([str(binary), "-n", "-b", str(circuit)],
                                cwd=temp, check=True, capture_output=True,
                                text=True, timeout=15)
    match = re.search(r"v\(mid\)\s*=\s*([-+\d.eE]+)", result.stdout)
    voltage = float(match.group(1)) if match else float("nan")
    if not math.isfinite(voltage) or abs(voltage - 5.0) > 1e-6:
        raise RuntimeError("Resistor-divider simulation did not produce 5 V")
    source = pin()
    return {"status": "ready", "version": VERSION, "binary": str(binary),
            "midpoint_v": voltage, "expected_v": 5.0, "tolerance_v": 1e-6,
            "source_url": source["url"], "source_sha256": source["sha256"],
            "checksum_url": source["checksum_url"],
            "configure_options": source["configure_options"],
            **({"unpacked_with": source["unpacked_with"],
                "unpacker_sha256": source["unpacker_sha256"]} if windows() else {}),
            "platform": platform.system(), "architecture": platform.machine(),
            "netlist": NETLIST, "simulation_stdout": result.stdout,
            "simulation_stderr": result.stderr, "version_stdout": version.stdout}


def add_link(binary):
    if windows():
        return add_command(binary)
    link = Path.home() / ".local" / "bin" / "ngspice"
    if link.is_symlink() and link.resolve() == binary.resolve():
        return "already linked"
    if os.path.lexists(link):
        return "existing path preserved; use runtime binary explicitly"
    link.parent.mkdir(parents=True, exist_ok=True)
    try:
        link.symlink_to(binary)
    except FileExistsError:
        return "path appeared during install; preserved"
    return "created " + str(link)


def command_body(binary):
    return '@"' + str(binary) + '" %*\r\n'


def command_state(binary):
    """Whether ~/.local/bin/ngspice.cmd, if any, starts this runtime."""
    command = Path.home() / ".local" / "bin" / "ngspice.cmd"
    try:
        body = command.read_bytes().decode("utf-8", errors="replace")
    except FileNotFoundError:
        return "absent"
    except OSError as error:
        return "unreadable: " + str(error)
    if body == command_body(binary):
        return "starts this runtime"
    return "starts another program; remove " + str(command) + " and install again"


def add_command(binary):
    """On Windows, ~/.local/bin/ngspice.cmd starts the console build.

    A link would not do: Windows looks for the build's DLLs beside the path
    it was started by, so the command has to name the real executable.
    """
    folder = Path.home() / ".local" / "bin"
    command = folder / "ngspice.cmd"
    # cmd.exe expands %NAME% and reads a .cmd file in the console code page,
    # so a path holding % or anything but ASCII would start nothing.
    if "%" in str(binary) or not all(ord(ch) < 128 for ch in str(binary)):
        return "runtime path cannot be written into a .cmd file; use runtime binary explicitly"
    body = command_body(binary)
    try:
        if command.read_bytes().decode("utf-8") == body:
            return "already linked"
    except (OSError, UnicodeDecodeError):
        pass
    suffixes = [""] + os.environ.get("PATHEXT", ".COM;.EXE;.BAT;.CMD").lower().split(";")
    if any(os.path.lexists(folder / ("ngspice" + suffix)) for suffix in suffixes):
        return "existing path preserved; use runtime binary explicitly"
    folder.mkdir(parents=True, exist_ok=True)
    try:
        with open(command, "xb") as stream:
            stream.write(body.encode("utf-8"))
    except FileExistsError:
        return "path appeared during install; preserved"
    return "created " + str(command)


def completed_install():
    """Do not accept a partially published or unrelated runtime as installed."""
    if (PREFIX / ".installing").exists() or not (PREFIX / "install.json").is_file():
        raise RuntimeError("Runtime is incomplete or unmanaged; inspect it first: " + str(PREFIX))
    try:
        record = json.loads((PREFIX / "install.json").read_text())
    except (OSError, ValueError) as error:
        raise RuntimeError("Runtime installation record is unreadable") from error
    if record.get("version") != VERSION or record.get("source_sha256") != pin()["sha256"]:
        raise RuntimeError("Runtime installation record does not match the source pin")


def install(archive_path):
    """Serialize build, publication, verification, metadata and user linking."""
    PREFIX.parent.mkdir(parents=True, exist_ok=True)
    lock = PREFIX.parent / ("." + VERSION + ".install.lock")
    try:
        lock.mkdir()
    except FileExistsError as error:
        raise RuntimeError("Install lock exists; inspect its owner before retrying: " + str(lock)) from error
    owner = lock / "owner.json"
    try:
        owner.write_text(json.dumps({"pid": os.getpid(), "version": VERSION}) + "\n")
        return install_locked(archive_path)
    finally:
        owner.unlink(missing_ok=True)
        lock.rmdir()


class HttpsOnly(urllib.request.HTTPRedirectHandler):
    """Follow a redirect only to HTTPS: a hop through plain HTTP was followed."""

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        if not newurl.startswith("https://"):
            raise RuntimeError("Download left HTTPS: " + newurl)
        return super().redirect_request(req, fp, code, msg, headers, newurl)


# Far above the pinned downloads, which are verified by SHA-256 after; only a
# hostile server sends more, and it would fill the disk first.
FETCH_LIMIT = 256 * 1024 * 1024


def fetch(url, destination, limit=FETCH_LIMIT, attempts=3):
    """Download over HTTPS only, into a new file of at most limit bytes.

    A failed attempt is tried again, as the macOS path's curl --retry 2 does.
    A refusal is not retried: leaving HTTPS, or passing the limit, raises.
    """
    for attempt in range(attempts):
        try:
            return download(url, destination, limit)
        except OSError:
            Path(destination).unlink(missing_ok=True)      # the next attempt needs the name free
            if attempt + 1 == attempts:
                raise
            time.sleep(2 ** attempt)


def download(url, destination, limit):
    request = urllib.request.Request(url, headers={"User-Agent": "ngspice-setup"})
    with urllib.request.build_opener(HttpsOnly).open(request, timeout=180) as response:
        if not response.geturl().startswith("https://"):
            raise RuntimeError("Download left HTTPS: " + response.geturl())
        written = 0
        with open(destination, "xb") as stream:
            while True:
                chunk = response.read(1024 * 1024)
                if not chunk:
                    break
                written += len(chunk)
                if written > limit:
                    raise RuntimeError("Download passed its " + str(limit) + "-byte limit: " + url)
                stream.write(chunk)


def verified(path, expected, what):
    actual = hashlib.sha256(Path(path).read_bytes()).hexdigest()
    if actual != expected:
        raise RuntimeError("SHA-256 mismatch: " + what + " rejected")


def install_windows(archive_path, binary):
    """Unpack the pinned prebuilt release with the pinned 7zr.exe, then publish it."""
    with tempfile.TemporaryDirectory(prefix="ngspice-install-") as temp:
        work = Path(temp)
        archive = Path(archive_path).resolve() if archive_path else work / "ngspice.7z"
        if archive_path is None:
            fetch(WINDOWS_URL, archive)
        verified(archive, WINDOWS_SHA256, "prebuilt archive")
        unpacker = work / "7zr.exe"
        fetch(SEVENZR_URL, unpacker)
        verified(unpacker, SEVENZR_SHA256, "7zr.exe")
        stage = (work / "stage").resolve()
        stage.mkdir()
        unpacked = subprocess.run([str(unpacker), "x", "-y", "-o" + str(stage), str(archive)],
                                  stdin=subprocess.DEVNULL, capture_output=True, timeout=300,
                                  text=True, errors="replace")
        if unpacked.returncode:
            # Its output was captured and thrown away, so the reason never showed.
            said = " | ".join(((unpacked.stdout or "") + (unpacked.stderr or "")).strip().splitlines()[-5:])
            raise RuntimeError("7zr could not unpack the release (exit " + str(unpacked.returncode)
                               + "): " + said)
        # 7-Zip refuses paths that leave the output folder; still, nothing
        # unpacked may be a link, a junction or anything but a file or folder.
        for folder, folders, files in os.walk(stage):
            for name in folders + files:
                info = os.lstat(os.path.join(folder, name))
                if (getattr(info, "st_file_attributes", 0) & stat.FILE_ATTRIBUTE_REPARSE_POINT
                        or not (stat.S_ISDIR(info.st_mode) or stat.S_ISREG(info.st_mode))):
                    raise RuntimeError("Unsafe archive entry: " + name)
        probe(stage / binary.relative_to(PREFIX))
        if os.path.lexists(PREFIX):
            raise RuntimeError("Runtime prefix appeared during install; preserved")
        try:
            PREFIX.mkdir()
        except FileExistsError as error:
            raise RuntimeError("Runtime prefix appeared during publication; preserved") from error
        (PREFIX / ".installing").write_text(str(os.getpid()) + "\n")
        for entry in stage.iterdir():
            target = PREFIX / entry.name
            if os.path.lexists(target):
                raise RuntimeError("Unexpected file in reserved runtime; preserved: " + str(target))
            shutil.move(str(entry), str(target))
    report = probe(binary)
    (PREFIX / "install.json").write_text(json.dumps(report, indent=2) + "\n")
    (PREFIX / ".installing").unlink()
    report["link"] = add_link(binary)
    return report


def install_locked(archive_path):
    binary = binary_path()
    if binary.exists():
        completed_install()
        report = probe(binary)
        report["link"] = add_link(binary)
        return report
    if os.path.lexists(PREFIX):
        raise RuntimeError("Runtime prefix exists without ngspice; inspect it first: " + str(PREFIX))
    if windows():
        return install_windows(archive_path, binary)
    if platform.system() != "Darwin":
        raise RuntimeError("This installer has been verified only for macOS")
    for tool in ("clang", "clang++", "xcrun", "make", "bison", "flex", "curl"):
        if not shutil.which(tool, path=os.defpath):
            raise RuntimeError("Required existing tool is missing: " + tool)
    with tempfile.TemporaryDirectory(prefix="ngspice-build-") as temp:
        work = Path(temp)
        archive = Path(archive_path).resolve() if archive_path else work / "source.tar.gz"
        if archive_path is None:
            subprocess.run(["curl", "--fail", "--location", "--proto", "=https",
                            "--proto-redir", "=https", "--tlsv1.2", "--retry", "2",
                            "--connect-timeout", "15", "--max-time", "180",
                            "--output", str(archive), SOURCE_URL], check=True)
        actual = hashlib.sha256(archive.read_bytes()).hexdigest()
        if actual != SHA256:
            raise RuntimeError("SHA-256 mismatch: source archive rejected")
        source = (work / "source").resolve()
        source.mkdir()
        with tarfile.open(archive) as package:
            # Validate every entry before extracting; no links or special files.
            for member in package.getmembers():
                destination = (source / member.name).resolve()
                if source not in destination.parents or not (member.isfile() or member.isdir()):
                    raise RuntimeError("Unsafe source archive entry: " + member.name)
            package.extractall(source)
        build = work / "build"
        build.mkdir()
        stage = work / "stage"
        env = {"PATH": os.defpath, "LC_ALL": "C", "CC": "clang", "CXX": "clang++"}
        sdk = subprocess.check_output(["xcrun", "--show-sdk-path"], env=env,
                                      text=True, timeout=15).strip()
        env["SDKROOT"] = sdk
        # Recent standalone CLT installs may omit the compiler-relative libc++
        # headers while retaining them inside the SDK. Keep this fix local.
        cxx_flags = ["-O2"]
        headers = Path(sdk) / "usr" / "include" / "c++" / "v1"
        if headers.is_dir():
            cxx_flags += ["-isystem", str(headers)]
        env["CXXFLAGS"] = shlex.join(cxx_flags)
        subprocess.run(["clang++"] + cxx_flags + ["-x", "c++", "-fsyntax-only", "-"],
                       input="#include <cmath>\nint main() { return std::abs(-1); }\n",
                       text=True, env=env, check=True, timeout=30)
        commands = [
            [str(source / ("ngspice-" + VERSION) / "configure"),
             "--prefix=" + str(PREFIX)] + CONFIGURE,
            ["make", "-j" + str(min(os.cpu_count() or 1, 4))],
            ["make", "install", "DESTDIR=" + str(stage)],
        ]
        log = work / "build.log"
        print("Building ngspice " + VERSION + " (log: " + str(log) + ")", file=sys.stderr)
        with log.open("w") as stream:
            for command in commands:
                stream.write("Command: " + repr(command) + "\n")
                stream.flush()
                result = subprocess.run(command, cwd=build, env=env, stdout=stream,
                                        stderr=subprocess.STDOUT, timeout=1200)
                if result.returncode:
                    # Keep useful diagnostics, without retaining a partial install.
                    print("\n".join(log.read_text(errors="replace").splitlines()[-70:]), file=sys.stderr)
                    raise RuntimeError("ngspice build failed with exit " + str(result.returncode))
        staged_prefix = stage / str(PREFIX).lstrip(os.sep)
        probe(staged_prefix / "bin" / "ngspice")
        # The lock serializes our installers. Atomic mkdir also refuses a
        # prefix created by another writer after this advisory existence check.
        if os.path.lexists(PREFIX):
            raise RuntimeError("Runtime prefix appeared during build; preserved")
        try:
            PREFIX.mkdir()
        except FileExistsError as error:
            raise RuntimeError("Runtime prefix appeared during publication; preserved") from error
        (PREFIX / ".installing").write_text(str(os.getpid()) + "\n")
        for entry in staged_prefix.iterdir():
            target = PREFIX / entry.name
            if os.path.lexists(target):
                raise RuntimeError("Unexpected file in reserved runtime; preserved: " + str(target))
            shutil.move(str(entry), str(target))
        shutil.copyfile(log, PREFIX / "build.log")
    report = probe(binary)
    (PREFIX / "install.json").write_text(json.dumps(report, indent=2) + "\n")
    (PREFIX / ".installing").unlink()
    report["link"] = add_link(binary)
    return report


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    modes = parser.add_mutually_exclusive_group()
    modes.add_argument("--install", action="store_true")
    modes.add_argument("--check", action="store_true")
    parser.add_argument("--archive", help="Use a local archive; published SHA-256 is still enforced")
    args = parser.parse_args()
    if args.archive and not args.install:
        parser.error("--archive requires --install")
    try:
        if args.install:
            report = install(args.archive)
        elif (PREFIX.parent / ("." + VERSION + ".install.lock")).exists():
            print(json.dumps({"status": "busy", "version": VERSION, "prefix": str(PREFIX)}))
            return 1
        elif not binary_path().is_file():
            print(json.dumps({"status": "missing", "version": VERSION, "prefix": str(PREFIX)}))
            return 1
        else:
            completed_install()
            report = probe(binary_path())
            if windows():
                # The command simulate_dc finds on PATH, which the probe does not run.
                report["command"] = command_state(binary_path())
        print(json.dumps(report, indent=2))
        return 0
    except (OSError, RuntimeError, subprocess.SubprocessError, tarfile.TarError) as error:
        print("ngspice setup: " + str(error), file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
