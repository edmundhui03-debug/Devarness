#!/usr/bin/env bash
# Explicit configs keep the dev display consistent even in nested repositories.
set -uo pipefail
src="${BASH_SOURCE[0]}"; hops=0
while [ -L "$src" ]; do
  hops=$((hops+1)); [ "$hops" -gt 40 ] && { printf '%s: symlink loop resolving %s\n' "statusline" "${BASH_SOURCE[0]}" >&2; exit 1; }
  dir="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  case "$src" in /*) ;; *) src="$dir/$src" ;; esac
done
ROOT="$(cd "$(dirname "$src")/../.." && pwd)"
export PATH="$PATH:$HOME/.local/bin"
export STARSHIP_CONFIG="$ROOT/.claude/hooks/starship.toml"
if [ "${1:-}" = --preview ]; then
  exec python3 "$ROOT/.claude/hooks/statusline_preview.py"
fi
if ! command -v cship >/dev/null 2>&1; then
  # bootstrap does not install cship: its release binary goes into ~/.local/bin by hand.
  printf 'dev | cship missing — install it by hand: %s/Harness/INSTALL.md\n' "$ROOT"
  exit 0   # nonzero makes Claude Code DISCARD the message; 0 displays it
fi
exec cship --config "$ROOT/cship.toml" "$@"
