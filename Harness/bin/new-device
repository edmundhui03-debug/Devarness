#!/usr/bin/env python3
"""Check the portable Devarness core; optional runtimes have separate checks."""
import argparse
import importlib.util
import json
import os
from pathlib import Path
import subprocess
import sys

SOURCE = Path(__file__).resolve().parents[2]
GIT_TIMEOUT = 15


def own_repository(root):
    # Inspect this checkout without environment redirects or personal Git config.
    env = {key: value for key, value in os.environ.items() if not key.startswith("GIT_")}
    env.update(GIT_CONFIG_NOSYSTEM="1", GIT_CONFIG_GLOBAL=os.devnull,
               GIT_OPTIONAL_LOCKS="0", GIT_TERMINAL_PROMPT="0")
    try:
        done = subprocess.run(["git", "-C", str(root), "rev-parse", "--show-toplevel"],
                              stdin=subprocess.DEVNULL, capture_output=True,
                              timeout=GIT_TIMEOUT, env=env,
                              creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0))
        return done.returncode == 0 and Path(done.stdout.decode("utf-8", "replace").strip()).resolve() == root
    except (OSError, RuntimeError, subprocess.TimeoutExpired):
        return False


def check(root):
    state = {"schema": 1, "core_ready": False, "missing": []}
    # --root selects data only; execute the trusted helper beside this script.
    sys.dont_write_bytecode = True
    spec = importlib.util.spec_from_file_location("devarness_bootstrap", SOURCE / "tools/bootstrap.py")
    bootstrap = importlib.util.module_from_spec(spec)
    try:
        spec.loader.exec_module(bootstrap)
        state = bootstrap.readiness(root)
    except OSError:
        state["missing"].append("Core files or Harness/repos.txt are missing or unreadable")
    except ValueError as error:
        state["missing"].append("Manifest: " + str(error))
    if not own_repository(root):
        state["missing"].append("Git checkout: select the root of its own worktree")
    state["core_ready"] = not state["missing"]
    state.update(root=str(root), scope="portable-core",
                 verdict="NEW DEVICE READY" if state["core_ready"] else "NEW DEVICE INCOMPLETE")
    return state


def main(argv=None):
    parser = argparse.ArgumentParser(prog="new-device", description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    checking = commands.add_parser("check", help="report portable core readiness without installing anything")
    checking.add_argument("--root", type=Path, default=SOURCE, help="checkout root to inspect")
    checking.add_argument("--home", help="compatibility option; personal homes are no longer inspected")
    checking.add_argument("--json", action="store_true", help="print the versioned portable report")
    checking.add_argument("--no-system", action="store_true", help="compatibility option; checks are always local")
    args = parser.parse_args(argv)
    root = args.root.expanduser().resolve()
    if not root.is_dir():
        parser.error("no such checkout folder: " + str(root))
    report = check(root)
    if args.json:
        print(json.dumps(report, indent=2))
    else:
        print("new-device portable core check")
        for missing in report["missing"]:
            print("Missing: " + missing)
        if "optional_sources_total" in report:
            print("Optional source checkouts: {optional_sources_present}/{optional_sources_total}".format(**report))
        print("Optional runtime readiness requires its specialist checks.")
        print(report["verdict"])
    return 0 if report["core_ready"] else 1


if __name__ == "__main__":
    raise SystemExit(main())
