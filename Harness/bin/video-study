#!/usr/bin/env python3
"""video-study — study a video from what is said and what is on screen.

  study   captions and a deduplicated transcript, the video at the highest
          bitrate within a height, timestamped contact sheets, a scene log
  frames  full-resolution frames at exact times, optionally cropped
  check   whether yt-dlp, ffmpeg, ffprobe and a timestamp font are present

Output always lands outside the dev tree, under the system temporary directory
by default: downloaded video, frames and transcripts are study material and
must never be committed. Standard-library Python 3.9 or later.
"""
from __future__ import annotations

import argparse
import hashlib
import html
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
FONT_CANDIDATES = (
    "/System/Harness/Fonts/Supplemental/Arial.ttf",
    "/System/Harness/Fonts/Helvetica.ttc",
    "C:/Windows/Fonts/arial.ttf",
    "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
    "/usr/share/fonts/dejavu/DejaVuSans.ttf",
)
CUE_TIME = re.compile(r"(?:(\d+):)?(\d{1,2}):(\d{2})[.,](\d{3})\s+-->")
TAG = re.compile(r"<[^>]+>")
SENTENCE_END = (".", "?", "!")
VIDEO_SUFFIXES = {".mp4", ".webm", ".mkv", ".mov"}


def parse_time(text: str) -> float:
    """Seconds from SS, MM:SS or HH:MM:SS; only the last field may carry decimals."""
    parts = text.strip().split(":")
    if len(parts) > 3:
        raise ValueError(f"not a time: {text!r}")
    total = 0.0
    for index, part in enumerate(parts):
        pattern = r"\d+(?:\.\d+)?" if index == len(parts) - 1 else r"\d+"
        if not re.fullmatch(pattern, part):
            raise ValueError(f"not a time: {text!r}")
        total = total * 60 + float(part)
    return total


def ffmpeg_time(seconds: float) -> str:
    """HH:MM:SS.mmm, the form ffmpeg's -ss accepts everywhere."""
    millis = int(round(seconds * 1000))
    hours, rest = divmod(millis, 3_600_000)
    minutes, rest = divmod(rest, 60_000)
    secs, millis = divmod(rest, 1000)
    return f"{hours:02d}:{minutes:02d}:{secs:02d}.{millis:03d}"


def clock(seconds: float) -> str:
    """MM:SS under an hour and H:MM:SS beyond, as a transcript reader expects."""
    whole = int(seconds)
    hours, rest = divmod(whole, 3600)
    minutes, secs = divmod(rest, 60)
    return f"{hours}:{minutes:02d}:{secs:02d}" if hours else f"{minutes:02d}:{secs:02d}"


def caption_lines(vtt: str) -> list[tuple[float, str]]:
    """Each caption line once, timed by the cue that introduced it.

    Auto-captions roll: every cue repeats the previous cue's text before adding
    its own, so the raw file states nearly everything twice. Cues are found by
    their timing lines: YouTube puts a line holding only a space between a
    cue's timing and its text, so only a truly empty line ends a cue.
    """
    cues: list[tuple[float, list[str]]] = []
    body: list[str] | None = None
    for row in vtt.replace("\r\n", "\n").split("\n"):
        match = CUE_TIME.search(row)
        if match:
            start = round(int(match.group(1) or 0) * 3600 + int(match.group(2)) * 60
                          + int(match.group(3)) + int(match.group(4)) / 1000, 3)
            body = []
            cues.append((start, body))
        elif row == "":
            body = None
        elif body is not None:
            text = html.unescape(TAG.sub("", row)).strip()
            if text:
                body.append(text)
    lines: list[tuple[float, str]] = []
    previous: list[str] = []
    for start, texts in cues:
        for text in texts:
            if text not in previous and (not lines or lines[-1][1] != text):
                lines.append((start, text))
        if texts:
            previous = texts
    return lines


def paragraphs(lines: list[tuple[float, str]], span: float = 30.0,
               max_span: float = 90.0) -> list[tuple[float, str]]:
    """Paragraphs of at least `span` seconds that end on a sentence, never longer than `max_span`."""
    out: list[tuple[float, str]] = []
    current: list[str] = []
    started = None
    for start, text in lines:
        if started is None:
            started = start
        current.append(text)
        if start - started >= max_span or (start - started >= span and text.endswith(SENTENCE_END)):
            out.append((started, " ".join(current)))
            current, started = [], None
    if current:
        out.append((started, " ".join(current)))
    return out


def render_transcript(paras: list[tuple[float, str]]) -> str:
    return "".join(f"[{clock(start)}] {text}\n\n" for start, text in paras)


def parse_scene_log(text: str) -> list[dict]:
    """ffmpeg metadata=print output as [{t, score}]."""
    scenes = []
    when = None
    for row in text.splitlines():
        found = re.search(r"pts_time:([0-9.]+)", row)
        if found:
            when = float(found.group(1))
            continue
        found = re.search(r"lavfi\.scene_score=([0-9.]+)", row)
        if found and when is not None:
            scenes.append({"t": round(when, 3), "score": round(float(found.group(1)), 4)})
            when = None
    return scenes


def parse_showinfo(stderr: str) -> list[float]:
    """The true time of every frame showinfo saw, in order."""
    return [float(found.group(1)) for found in
            re.finditer(r"Parsed_showinfo[^\n]*?pts_time:\s*([0-9.]+)", stderr)]


def filter_path(value: str) -> str:
    """A path as an ffmpeg filter option: forward slashes, ':' and quote escaped."""
    return value.replace("\\", "/").replace(":", "\\:").replace("'", "\\'")


def sheet_graph(every: float, cols: int, rows: int, font: str | None, threshold: float) -> str:
    """Contact sheets from the first frame at or after each interval, plus a scene log.

    `select` keeps each chosen frame's own timestamp, so the burned-in stamp and
    sheets.json give the time the tile really shows.
    """
    stamp = ""
    if font:
        stamp = (f",drawtext=fontfile='{filter_path(font)}':text='%{{pts\\:hms}}'"
                 ":x=4:y=4:fontsize=16:fontcolor=yellow:box=1:boxcolor=black@0.7")
    return ("[0:v]fps=2,scale=320:-2,split=2[a][b];"
            f"[a]select='isnan(prev_selected_t)+gte(t-prev_selected_t\\,{every})',showinfo{stamp},"
            f"tile={cols}x{rows}:padding=2:color=white[sheets];"
            f"[b]select='gt(scene\\,{threshold})',metadata=print:file=scenes.txt[scenes]")


def ytdlp_caption_cmd(url: str, out: Path) -> list[str]:
    return ["yt-dlp", "--no-playlist", "--skip-download", "--write-info-json",
            "--write-subs", "--write-auto-subs", "--sub-langs", "en.*,en",
            "--sub-format", "vtt", "-o", str(out / "video.%(ext)s"), url]


def ytdlp_video_cmd(url: str, out: Path, height: int) -> list[str]:
    # `<=?` keeps formats whose height is unknown, typical of direct-file URLs.
    return ["yt-dlp", "--no-playlist", "-f", f"bv*[height<=?{height}]/b[height<=?{height}]",
            "-S", "res,tbr", "-o", str(out / "video.%(ext)s"), url]


def youtube_id(url: str) -> str | None:
    found = re.search(r"(?:v=|youtu\.be/|shorts/)([A-Za-z0-9_-]{11})", url)
    return found.group(1) if found else None


def default_out(name: str) -> Path:
    safe = re.sub(r"[^A-Za-z0-9._-]+", "-", name).strip("-") or "video"
    return Path(tempfile.gettempdir()) / "video-study" / safe


def inside_root(candidate: Path) -> bool:
    """True for dev or anything below it, compared by file identity.

    Paths are compared through their nearest existing folder with samefile, so a
    case variant on a case-insensitive disk or a symlink cannot slip past.
    """
    probe = candidate.expanduser().absolute()
    while not probe.exists():
        if probe.parent == probe:
            return False
        probe = probe.parent
    resolved = probe.resolve()
    for node in (resolved, *resolved.parents):
        try:
            if os.path.samefile(node, ROOT):
                return True
        except OSError:
            continue
    return False


def run_visible(cmd: list[str]) -> None:
    """Run a download with its progress on stderr, keeping stdout for the JSON result."""
    subprocess.run(cmd, check=True, stdout=sys.stderr)


def tool_versions() -> dict:
    found: dict = {}
    for name, flag in (("yt-dlp", "--version"), ("ffmpeg", "-version"), ("ffprobe", "-version")):
        exe = shutil.which(name)
        if not exe:
            found[name] = None
            continue
        done = subprocess.run([exe, flag], capture_output=True, text=True)
        first = (done.stdout or done.stderr).strip().splitlines()
        found[name] = first[0] if first else "unknown"
    return found


def find_font() -> str | None:
    return next((font for font in FONT_CANDIDATES if Path(font).is_file()), None)


def ffmpeg_features() -> dict:
    """What this ffmpeg can do: -fps_mode arrived in 5.1, drawtext needs a build with it."""
    exe = shutil.which("ffmpeg")
    if not exe:
        return {"version": None, "fps_mode": False, "drawtext": False}
    first = (subprocess.run([exe, "-hide_banner", "-version"], capture_output=True, text=True).stdout
             or "").splitlines()
    found = re.search(r"version n?(\d+)\.(\d+)", first[0] if first else "")
    version = (int(found.group(1)), int(found.group(2))) if found else None
    filters = subprocess.run([exe, "-hide_banner", "-filters"], capture_output=True, text=True).stdout or ""
    return {"version": f"{version[0]}.{version[1]}" if version else None,
            # an unparsed version string is a git build, which is recent
            "fps_mode": version is None or version >= (5, 1),
            "drawtext": re.search(r"^\s*\S+\s+drawtext\s", filters, re.M) is not None}


def fetch_transcript(url: str, out: Path) -> dict | None:
    """Captions and transcript; a failure is recorded, because the screen track does not need them."""
    done = subprocess.run(ytdlp_caption_cmd(url, out), stdout=sys.stderr)
    captions = pick_captions(out)
    if not captions:
        if done.returncode != 0:
            return {"error": f"yt-dlp exited {done.returncode} fetching captions; the screen track continues"}
        return None
    paras = paragraphs(caption_lines(captions.read_text(encoding="utf-8")))
    (out / "transcript.txt").write_text(render_transcript(paras), encoding="utf-8")
    return {"captions": captions.name, "paragraphs": len(paras)}


def stale_videos(out: Path, source: str, height: int) -> list[Path]:
    """Media left by an earlier study of another source or height, which yt-dlp would reuse."""
    study = out / "study.json"
    if not study.is_file():
        return []
    previous = json.loads(study.read_text(encoding="utf-8"))
    if previous.get("source") == source and previous.get("height") == height:
        return []
    return [item for item in sorted(out.glob("video.*")) if item.suffix in VIDEO_SUFFIXES]


def duration(video: Path) -> float:
    done = subprocess.run(["ffprobe", "-v", "error", "-show_entries", "format=duration",
                           "-of", "default=noprint_wrappers=1:nokey=1", str(video)],
                          capture_output=True, text=True, check=True)
    return float(done.stdout.strip())


def pick_captions(out: Path) -> Path | None:
    for name in ("video.en.vtt", "video.en-orig.vtt"):
        if (out / name).is_file():
            return out / name
    found = sorted(out.glob("video.*.vtt"))
    return found[0] if found else None


def downloaded_video(out: Path) -> Path:
    for candidate in sorted(out.glob("video.*")):
        if candidate.suffix in VIDEO_SUFFIXES:
            return candidate
    raise RuntimeError(f"yt-dlp produced no video file in {out}")


def make_sheets(video: Path, out: Path, every: float = 5.0, cols: int = 6, rows: int = 5,
                threshold: float = 0.015) -> dict:
    sheets = out / "sheets"
    sheets.mkdir(parents=True, exist_ok=True)
    for old in sheets.glob("sheet_*.jpg"):
        old.unlink()
    features = ffmpeg_features()
    font = find_font() if features["drawtext"] else None
    passthrough = ["-fps_mode", "passthrough"] if features["fps_mode"] else ["-vsync", "passthrough"]
    done = subprocess.run(
        ["ffmpeg", "-hide_banner", "-nostats", "-loglevel", "info", "-i", str(video.resolve()),
         "-filter_complex", sheet_graph(every, cols, rows, font, threshold),
         "-map", "[sheets]", *passthrough, "-q:v", "3", "sheets/sheet_%02d.jpg",
         "-map", "[scenes]", "-f", "null", "-"],
        cwd=out, capture_output=True, text=True)
    if done.returncode != 0:
        raise RuntimeError("ffmpeg could not build contact sheets:\n" + done.stderr[-2000:])
    per = cols * rows
    index = [{"sheet": f"sheets/sheet_{i // per + 1:02d}.jpg", "tile": i % per,
              "t": round(t, 3), "clock": clock(t)} for i, t in enumerate(parse_showinfo(done.stderr))]
    (out / "sheets.json").write_text(json.dumps(index, indent=1) + "\n", encoding="utf-8")
    log = out / "scenes.txt"
    scenes = parse_scene_log(log.read_text(encoding="utf-8") if log.is_file() else "")
    (out / "scenes.json").write_text(json.dumps(scenes, indent=1) + "\n", encoding="utf-8")
    return {"sheets": len(list(sheets.glob("sheet_*.jpg"))), "tiles": len(index),
            "timestamps_burned_in": bool(font), "scene_changes": len(scenes)}


def extract_frames(video: Path, out: Path, times: list[float], crop: str | None = None) -> list[Path]:
    if crop and not re.fullmatch(r"\d+:\d+:\d+:\d+", crop):
        raise ValueError("--crop takes W:H:X:Y in pixels")
    out.mkdir(parents=True, exist_ok=True)
    written = []
    for moment in times:
        stamp = ffmpeg_time(moment)
        name = "frame_" + stamp.replace(":", "").replace(".", "_")
        if crop:
            name += "_crop" + crop.replace(":", "-")
        target = out / (name + ".jpg")
        if target.exists():
            target.unlink()
        cmd = ["ffmpeg", "-hide_banner", "-loglevel", "error", "-ss", stamp, "-i", str(video.resolve()),
               "-frames:v", "1", "-q:v", "2"]
        if crop:
            cmd += ["-vf", "crop=" + crop]
        subprocess.run(cmd + ["-y", str(target)], check=True)
        if not target.is_file() or target.stat().st_size == 0:
            raise RuntimeError(f"no frame at {stamp}; is it past the end of the video?")
        written.append(target)
    return written


def refuse_inside_root(out: Path) -> None:
    if inside_root(out):
        raise RuntimeError(f"refusing to write inside dev ({out}); video, frames and "
                           "transcripts stay out of the repository")


def cmd_check(args) -> int:
    tools = tool_versions()
    features = ffmpeg_features()
    print(json.dumps({"tools": tools, "ffmpeg": features,
                      "timestamp_font": find_font() if features["drawtext"] else None}, indent=2))
    return 0 if all(tools.values()) else 1


def cmd_study(args) -> int:
    if args.every <= 0:
        raise ValueError("--every must be positive")
    source = args.source
    is_url = re.match(r"https?://", source) is not None
    local = None if is_url else Path(source).expanduser()
    if local is not None and not local.is_file():
        raise RuntimeError(f"no such video file: {source}")
    name = (youtube_id(source) or hashlib.sha1(source.encode()).hexdigest()[:12]) if is_url else local.stem
    out = Path(args.out).expanduser() if args.out else default_out(name)
    refuse_inside_root(out)
    out.mkdir(parents=True, exist_ok=True)
    record: dict = {"source": source, "out": str(out), "height": args.height,
                    "tools": tool_versions(), "transcript": None}
    if is_url:
        record["transcript"] = fetch_transcript(source, out)
        info = out / "video.info.json"
        if info.is_file():
            record["title"] = json.loads(info.read_text(encoding="utf-8")).get("title")
        for stale in stale_videos(out, source, args.height):
            stale.unlink()
        run_visible(ytdlp_video_cmd(source, out, args.height))
        video = downloaded_video(out)
    else:
        video = local.resolve()
    record["video"] = str(video)
    record["duration_s"] = round(duration(video), 3)
    record["sheets"] = make_sheets(video, out, every=args.every)
    (out / "study.json").write_text(json.dumps(record, indent=2) + "\n", encoding="utf-8")
    print(json.dumps(record, indent=2))
    print(f"next: read transcript.txt and sheets/ in {out}, then "
          f"video-study frames {out} --at MM:SS,... for full-resolution frames", file=sys.stderr)
    return 0


def cmd_frames(args) -> int:
    source = Path(args.source).expanduser()
    if source.is_dir():
        study = source / "study.json"
        if not study.is_file():
            raise RuntimeError(f"{source} has no study.json; pass a video file instead")
        video = Path(json.loads(study.read_text(encoding="utf-8"))["video"])
        fallback = source / "frames"
    elif source.is_file():
        video = source
        fallback = default_out(source.stem) / "frames"
    else:
        raise RuntimeError(f"no such study directory or video: {source}")
    out = Path(args.out).expanduser() if args.out else fallback
    refuse_inside_root(out)
    times = [parse_time(item) for item in args.at.split(",") if item.strip()]
    if not times:
        raise ValueError("--at needs at least one time")
    for frame in extract_frames(video, out, times, args.crop):
        print(frame)
    return 0


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="video-study", description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="command")
    sub.add_parser("check", help="are yt-dlp, ffmpeg, ffprobe and a timestamp font present")
    study = sub.add_parser("study", help="transcript, video, contact sheets and scene log")
    study.add_argument("source", help="a video URL or a local video file")
    study.add_argument("--out", help="working directory; default under the system temp directory")
    study.add_argument("--height", type=int, default=1080, help="maximum video height to download")
    study.add_argument("--every", type=float, default=5.0, help="seconds between contact-sheet tiles")
    frames = sub.add_parser("frames", help="full-resolution frames at exact times")
    frames.add_argument("source", help="a study directory or a video file")
    frames.add_argument("--at", required=True, help="comma-separated SS, MM:SS or HH:MM:SS")
    frames.add_argument("--crop", help="W:H:X:Y in pixels")
    frames.add_argument("--out", help="output directory; default is the study's frames/")
    args = parser.parse_args(argv)
    handlers = {"check": cmd_check, "study": cmd_study, "frames": cmd_frames}
    if args.command not in handlers:
        parser.print_help()
        return 0
    try:
        return handlers[args.command](args)
    except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as error:
        print("video-study: " + str(error), file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
