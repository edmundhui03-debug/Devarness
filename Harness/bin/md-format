#!/usr/bin/env python3
"""md-format — the dev markdown house format: check, index and repair.

No dependencies. Same shape as i18n: one file, system python3, no network.

    md-format check [PATH ...]     check files (default: every tracked .md)
    md-format status [PATH ...]    the workspace-wide index of what is open
    md-format toc FILE ...         insert or refresh the Contents block
    md-format fix FILE ...         repair only what cannot be got wrong

The rule itself lives in .claude/skills/markdown-format/SKILL.md. This enforces it.
"""
from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import subprocess
import sys
from pathlib import Path

WIDTH = 80
TOC_MIN_LINES = 150
DOC_STATUS = ('current', 'draft', 'superseded', 'historical')
# Severity order: md-format status prints the groups in this order, so the thing
# that stops work is at the top of the list rather than buried alphabetically.
SECTION_STATUS = ('blocked', 'needs-owner', 'open', 'partial', 'fixed')

# Not ours to reformat: skipped completely. A tracked path that resolves
# somewhere else is a symlinked alias of a vendored skill — the real file is
# checked under its own path if we own it, so the alias is never checked twice.
NOT_OURS = (
    re.compile(r'(^|/)\.agents/'),             # installed skill packs
    re.compile(r'/datasheets/extracted/'),     # md-pages output
    re.compile(r'(^|/)node_modules/'),
    re.compile(r'(^|/)\.history/'),            # KiCad local history
    # Captured source material, not authored documents. The handbooks are
    # upstream KiCad and Altium pages converted to Markdown — they still open
    # with "Toggle navigation" — and the video directory holds transcripts and
    # the lesson notes derived from them. Reformatting evidence to satisfy a
    # format is the one thing the house rule explicitly warns against.
    re.compile(r'/research/handbooks/'),
    re.compile(r'/research/videos/'),
)

# Ours, but carrying a schema that owns the top of the file. The prose, table,
# link and width rules apply; the header block and Contents rules do not.
PROSE_ONLY = (
    re.compile(r'(^|/)SKILL\.md$'),            # skill front matter is the contract
)

# Loaded on every turn, so a Contents list costs every turn and helps nobody.
ALWAYS_ON = {'CLAUDE.md', 'AGENTS.md', '.claude/CLAUDE.md'}  # folder notes load on demand

META_RE = re.compile(
    r'^>\s+\*\*(?P<date>\d{4}-\d{2}-\d{2})\*\*\s+·\s+(?P<agent>[A-Z][A-Za-z]+)'
    r'\s+·\s+`(?P<status>[a-z-]+)`\s*$'
)
SECTION_STATUS_RE = re.compile(r'^`(?P<status>[a-z][a-z-]*)`(?:\s+·\s+(?P<gloss>.*))?$')
HEADING_RE = re.compile(r'^(?P<hashes>#{1,6})\s+(?P<text>.+?)\s*#*$')
ALERT_RE = re.compile(r'^>\s*\[!(NOTE|TIP|IMPORTANT|WARNING|CAUTION)\]\s*$')
LINK_RE = re.compile(r'(?<!\!)\[[^\]]*\]\(([^)\s]+?)(?:\s+"[^"]*")?\)')


def repo_root() -> Path:
    here = Path(__file__).resolve()
    for parent in here.parents:
        if (parent / 'CLAUDE.md').is_file() and (parent / '.claude').is_dir():
            return parent
    return here.parents[2]


ROOT = repo_root()


def separate_projects() -> tuple[str, ...]:
    """The owner's separate projects, listed once in Harness/separate-projects.txt.

    Nested projects with their own remotes and their own conventions. The house
    format binds dev; it does not reach across into the owner's separate work.
    The list lived here until 2026-09-17 and still said Self Learning two days
    after the rename to Research, so check reported 1,223 of Research's problems.
    """
    record = ROOT / 'Harness/separate-projects.txt'
    try:
        return tuple(line.strip() for line in record.read_text().splitlines()
                     if line.strip() and not line.startswith('#'))
    except OSError:
        return ()


def within(name: str, roots) -> bool:
    """Whether a root-relative path is one of these roots or inside one."""
    return any(name == r or name.startswith(r + '/') for r in roots)


def _listed_markdown(root: Path) -> list[Path]:
    try:
        out = subprocess.run(
            ['git', '-C', str(root), 'ls-files', '-z', '*.md'],
            capture_output=True, text=True, check=True).stdout
    except (OSError, subprocess.CalledProcessError):
        return sorted(root.rglob('*.md'))
    return [root / p for p in out.split('\0') if p]


def vendored_clones() -> set[str]:
    """The upstream clones the Library reproduces, and the owner's personal ones
    (~/.config/devarness/personal-repos.txt, the book PDFs). Never ours to reformat."""
    paths = set()
    for record in (ROOT / 'Harness/repos.txt', Path.home() / '.config/dev/personal-repos.txt'):
        try:
            for line in record.read_text().splitlines():
                if line.strip() and not line.startswith('#'):
                    paths.add(line.split('\t')[0])
        except OSError:
            pass
    return paths


def house_satellites() -> list[Path]:
    """Nested repos that are ours, which `git ls-files` at the root cannot see.

    A project imported into dev is its own repository, outside dev's index, so
    a target set built only from the root's tracked files would silently omit
    it. A workspace-wide map of open items that cannot see a project is not
    workspace-wide.

    Left out, each for a reason: vendored upstream clones (listed in
    repos.txt, never edited here), a clone update-tools has not finished (<path>.partial, upstream's too), the owner's separate projects,
    and git worktrees, whose content is already reported under the checkout
    they belong to.
    """
    vendored = vendored_clones()
    found = []
    for marker in sorted(ROOT.glob('*/.git')) + sorted(ROOT.glob('*/*/.git')):
        repo = marker.parent
        name = repo.relative_to(ROOT).as_posix()   # '/' on Windows too; the lists use '/'
        if within(name, vendored) or within(name, separate_projects()) or name.endswith('.partial'):
            continue
        if marker.is_file():
            continue  # a worktree; its files are reported under the main checkout
        found.append(repo)
    return found


def tracked_markdown() -> list[Path]:
    paths = _listed_markdown(ROOT)
    seen = {p.resolve() for p in paths}
    for satellite in house_satellites():
        for path in _listed_markdown(satellite):
            if path.resolve() not in seen:
                seen.add(path.resolve())
                paths.append(path)
    return paths


def rel(path: Path) -> str:
    """The path as tracked — never resolved, so a symlink shows where it lives.

    Forward slashes on every system: the patterns below match on '/', and
    with Windows' backslashes the SKILL.md waiver and the template exemption
    never matched there (two selftests failed on 2026-09-19).
    """
    try:
        return path.absolute().relative_to(ROOT).as_posix()
    except ValueError:
        return path.as_posix()


def not_ours(path: Path) -> bool:
    if path.absolute() != path.resolve():
        return True                       # an alias of a vendored skill
    name = rel(path)
    # A project skill installed from a clone under Harness/ is upstream's file —
    # but only while it is still upstream's bytes. The moment we adapt one it
    # becomes ours and must be checked, which is how two pre-rename paths sat
    # unnoticed in .claude/skills/markitdown/SKILL.md.
    m = re.match(r'\.claude/skills/([^/]+)/', name)
    if m:
        clone = ROOT / 'Harness' / m.group(1)
        if clone.is_dir():
            try:
                mine = path.read_bytes()
                if any(c.read_bytes() == mine for c in clone.rglob(path.name)):
                    return True
            except OSError:
                return True
    return any(rx.search(name) for rx in NOT_OURS)


def header_exempt(path: Path) -> bool:
    name = rel(path)
    return any(rx.search(name) for rx in PROSE_ONLY)


def content_width(line: str) -> int:
    """Width of what a reader sees: markers dropped, link targets collapsed.

    A link's URL is not prose — the reader sees only its text — so a generated
    Contents entry is measured on its heading, not on the anchor behind it.
    """
    stripped = re.sub(r'^(\s*(?:>\s?)+)', '', line)
    stripped = re.sub(r'^\s*(?:[-*+]|\d+\.)\s+', '', stripped)
    stripped = re.sub(r'(?<!\!)\[([^\]]*)\]\([^)]*\)', r'\1', stripped)
    stripped = re.sub(r'<https?://[^>]*>', '', stripped)
    stripped = re.sub(r'\bhttps?://\S+', '', stripped)   # a bare URL cannot wrap
    # A long path or identifier in backticks cannot wrap either. It is one
    # token: no line break can go inside it, so counting it toward a wrap
    # budget asks the author for something the format cannot express.
    stripped = re.sub(r'`[^`\n]*/[^`\n]*`(?<=.{26})', '', stripped)
    return len(stripped)


def slug(text: str) -> str:
    text = re.sub(r'`([^`]*)`', r'\1', text)
    text = re.sub(r'\*\*([^*]*)\*\*', r'\1', text)
    text = re.sub(r'\*([^*]*)\*', r'\1', text)
    text = re.sub(r'\[([^\]]*)\]\([^)]*\)', r'\1', text)
    text = text.lower().strip()
    text = re.sub(r'[^\w\s-]', '', text, flags=re.UNICODE)
    return re.sub(r'\s+', '-', text)


class Doc:
    def __init__(self, path: Path):
        self.path = path
        self.raw = path.read_text(encoding='utf-8', errors='replace')
        self.lines = self.raw.split('\n')
        if self.lines and self.lines[-1] == '':
            self.lines.pop()
        self._classify()

    def _classify(self):
        """Mark which lines are code, table, heading, so prose rules skip them."""
        self.kind = []
        fence = None
        # YAML front matter, or a leading HTML comment such as the
        # diagram-design profile header, owns the top of the file.
        self.front = 0
        if self.lines and self.lines[0].strip() == '---':
            for n in range(1, len(self.lines)):
                if self.lines[n].strip() in ('---', '...'):
                    self.front = n + 1
                    break
        elif self.lines and self.lines[0].lstrip().startswith('<!--'):
            for n, probe in enumerate(self.lines):
                if '-->' in probe:
                    self.front = n + 1
                    break
        # The first kind that matches wins, so the order below is the rule:
        # a fence beats everything, then a table (an indented line that
        # starts with `|` is a table, not indent), then a heading, then indent.
        for n, line in enumerate(self.lines):
            if n < self.front:
                self.kind.append('front')
                continue
            m = re.match(r'^\s*(```+|~~~+)', line)
            if fence:
                self.kind.append('code')
                if m and m.group(1)[0] == fence[0] and len(m.group(1)) >= len(fence):
                    fence = None
                continue
            if m:
                fence = m.group(1)
                self.kind.append('code')
            elif re.sub(r'^\s*(?:>\s?)+', '', line).lstrip().startswith('|'):
                self.kind.append('table')   # including one inside a blockquote
            elif HEADING_RE.match(line):
                self.kind.append('heading')
            elif re.match(r'^\s{4,}\S', line):
                self.kind.append('indent')
            else:
                self.kind.append('prose')

    def opens_section(self, i: int) -> bool:
        """True if line i is the first content line under a heading."""
        j = i - 1
        while j >= 0 and not self.lines[j].strip():
            j -= 1
        return j >= 0 and self.kind[j] == 'heading'

    def heading_above(self, i: int) -> str:
        found = ''
        for j, _level, text in self.headings():
            if j >= i:
                break
            found = text
        return found

    def headings(self):
        for i, line in enumerate(self.lines):
            if self.kind[i] != 'heading':
                continue
            m = HEADING_RE.match(line)
            yield i, len(m.group('hashes')), m.group('text')

    def toc_bounds(self):
        """(start, end) line indices of the Contents block, or None."""
        for i, level, text in self.headings():
            if level == 2 and text.strip().lower() == 'contents':
                j = i + 1
                while j < len(self.lines) and self.kind[j] != 'heading':
                    j += 1
                return i, j
        return None

    def build_toc(self):
        bounds = self.toc_bounds()
        skip = range(*bounds) if bounds else range(0, 0)
        rows, seen = [], {}
        for i, level, text in self.headings():
            if level not in (2, 3) or i in skip:
                continue
            if text.strip().lower() == 'contents':
                continue
            s = slug(text)
            seen[s] = seen.get(s, 0) + 1
            if seen[s] > 1:
                s = f'{s}-{seen[s] - 1}'
            indent = '  ' if level == 3 else ''
            rows.append(f'{indent}- [{text}](#{s})')
        return rows


def check(path: Path) -> list[str]:
    problems: list[str] = []

    def bad(line_no: int, code: str, msg: str):
        problems.append(f'{rel(path)}:{line_no}: {code} {msg}')

    doc = Doc(path)
    lines, kind = doc.lines, doc.kind
    if not lines:
        return [f'{rel(path)}:1: E001 empty file']

    # --- title -----------------------------------------------------------
    h1s = [(i, t) for i, lv, t in doc.headings() if lv == 1]
    first_content = next((i for i in range(doc.front, len(lines))
                          if lines[i].strip()), doc.front)
    if not h1s:
        bad(1, 'E001', 'no H1 title')
    elif len(h1s) > 1:
        bad(h1s[1][0] + 1, 'E001', f'{len(h1s)} H1 titles; a document has one')
    elif h1s[0][0] != first_content:
        bad(h1s[0][0] + 1, 'E001', 'the H1 must be the first content line')

    # --- setext headings -------------------------------------------------
    # Title\n===== is a real H1, so "no H1 title" would send the author
    # looking for something they did write. Name what is actually wrong.
    for i in range(1, len(lines)):
        if kind[i] in ('code', 'front') or not re.match(r'^\s*(=|-){3,}\s*$', lines[i]):
            continue
        if lines[i - 1].strip() and kind[i - 1] == 'prose':
            style = 'H1' if lines[i].strip()[0] == '=' else 'H2'
            bad(i + 1, 'E002',
                f'underlined {style}; write it as {"#" * (1 if style == "H1" else 2)} '
                f'{lines[i - 1].strip()[:40]}')

    # --- heading levels --------------------------------------------------
    prev = 0
    for i, level, text in doc.headings():
        if prev and level > prev + 1:
            bad(i + 1, 'E007', f'heading jumps H{prev} to H{level}')
        prev = level

    # --- header block ----------------------------------------------------
    exempt = header_exempt(path)
    if h1s and not exempt:
        i = h1s[0][0] + 1
        while i < len(lines) and not lines[i].strip():
            i += 1
        quote = []
        j = i
        while j < len(lines) and lines[j].startswith('>'):
            quote.append(lines[j])
            j += 1
        if not quote:
            bad(h1s[0][0] + 1, 'E003',
                'no header block; see ' + (ROOT / 'Harness/templates/markdown-doc.md').as_posix())
        else:
            m = META_RE.match(quote[0])
            if not m:
                bad(i + 1, 'E004',
                    'header line must read: > **YYYY-MM-DD** · Agent · `status`')
            elif m.group('status') not in DOC_STATUS:
                bad(i + 1, 'E005',
                    f"document status '{m.group('status')}' not in "
                    f"{'/'.join(DOC_STATUS)}")
            body = ' '.join(l.lstrip('>').strip() for l in quote[1:]).strip()
            if len(re.findall(r'[.!?](\s|$)', body)) < 2:
                bad(i + 1, 'E006',
                    'summary needs at least two sentences saying what this concludes')

    # --- contents --------------------------------------------------------
    if not exempt and len(lines) > TOC_MIN_LINES:
        bounds = doc.toc_bounds()
        if not bounds:
            if rel(path) not in ALWAYS_ON:
                bad(1, 'E009',
                    f'{len(lines)} lines: needs a Contents block (md-format toc)')
        else:
            have = [l for l in lines[bounds[0] + 1:bounds[1]] if l.strip()]
            want = doc.build_toc()
            if have != want:
                bad(bounds[0] + 1, 'E010', 'Contents is stale (md-format toc)')

    # --- section status, alerts, width, whitespace ------------------------
    alerts = 0
    for i, line in enumerate(lines):
        n = i + 1
        if ALERT_RE.match(line):
            alerts += 1
            if alerts == 2:
                bad(n, 'E012',
                    'more than one alert; keep it for the one thing that blocks')
        if kind[i] == 'prose' and line.strip():
            m = SECTION_STATUS_RE.match(line.strip())
            if m and doc.opens_section(i):
                s = m.group('status')
                if s not in SECTION_STATUS:
                    bad(n, 'E011', f"status '{s}' not in {'/'.join(SECTION_STATUS)}")
        if kind[i] in ('prose', 'heading') and content_width(line) > WIDTH:
            # A heading is one line by definition; it cannot be wrapped, so say
            # what can actually be done about it instead.
            advice = ('shorten this heading' if kind[i] == 'heading'
                      else f'wrap prose at {WIDTH}')
            bad(n, 'E008', f'{content_width(line)} columns; {advice}')
        # Inside a fence the bytes are the point: a literal tab can be a field
        # separator and trailing space can be part of a fixture. Leave them.
        if kind[i] != 'code':
            if line != line.rstrip():
                bad(n, 'E014', 'trailing whitespace')
            if '\t' in line:
                bad(n, 'E014', 'tab; use spaces')

    # --- tables ----------------------------------------------------------
    run: list[tuple[int, int]] = []
    for i, line in enumerate(lines + ['']):
        if i < len(lines) and kind[i] == 'table':
            # \| is an escaped pipe inside a cell, not a column break
            cells = line.replace(r'\|', '\0').strip().strip('|')
            run.append((i, cells.count('|') + 1))
            continue
        if run:
            widths = {c for _, c in run}
            if len(widths) > 1:
                bad(run[0][0] + 1, 'E015',
                    f'table columns vary: {sorted(widths)}')
            run = []

    # --- links -----------------------------------------------------------
    for i, line in enumerate(lines):
        if kind[i] == 'code':
            continue
        for target in LINK_RE.findall(line):
            if re.match(r'^(https?:|mailto:|#|<)', target):
                continue
            from urllib.parse import unquote
            dest = (path.parent / unquote(target.split('#')[0])).resolve()
            if target.split('#')[0] and not dest.exists():
                bad(i + 1, 'E013', f'link target missing: {target}')

    if not doc.raw.endswith('\n'):
        bad(len(lines), 'E014', 'no newline at end of file')
    return problems


def _write_lf(path: Path, text: str) -> None:
    """Write UTF-8 with LF endings. Text mode turns every newline into CRLF on
    Windows, which put a CR on every line of any document md-format rewrote there."""
    path.write_bytes(text.encode('utf-8'))


def fix(path: Path) -> bool:
    """Repair only the unambiguous things. Never rewraps prose, never touches
    a line inside a fence — those bytes may be a fixture or a tab-separated
    field, and stripping them would break what the document is evidence of."""
    doc = Doc(path)
    lines = [l if doc.kind[i] == 'code' else l.rstrip()
             for i, l in enumerate(doc.lines)]
    changed = lines != doc.lines
    out = '\n'.join(lines) + '\n'
    if out != doc.raw:
        _write_lf(path, out)
        changed = True
    return changed


def rewrap(path: Path) -> bool:
    """Rewrap plain prose paragraphs to WIDTH. Everything else is left byte
    for byte: front matter, fences, tables, headings, lists and blockquotes.

    Front matter is the one that bites. A skill's `description:` is a single
    long YAML line; wrapping it silently destroys the skill, which is exactly
    what an ad-hoc version of this function did to grill-first and markitdown
    before it lived here. Blockquotes are left alone too — rewrapping one
    means re-deriving its prefix, and the header block is a blockquote.
    """
    import textwrap

    doc = Doc(path)
    out: list[str] = []
    para: list[str] = []

    def flush():
        if para:
            if all(content_width(l) <= WIDTH for l in para):
                out.extend(para)          # already fine; do not reflow it
            else:
                out.extend(textwrap.wrap(' '.join(para), width=WIDTH,
                                         break_long_words=False,
                                         break_on_hyphens=False))
            para.clear()

    item: list[str] = []
    marker = ''

    def flush_item():
        """A list item wraps with a hanging indent under its own marker."""
        if not item:
            return
        if content_width(marker + ' '.join(item)) <= WIDTH:
            out.append((marker + ' '.join(item)).rstrip())
            item.clear()
            return
        pad = ' ' * len(marker)
        out.extend(textwrap.wrap(' '.join(item), width=WIDTH,
                                 initial_indent=marker, subsequent_indent=pad,
                                 break_long_words=False, break_on_hyphens=False)
                   or [marker.rstrip()])
        item.clear()

    i = 0
    while i < len(doc.lines):
        line = doc.lines[i]
        stripped = line.strip()
        kind = doc.kind[i]

        # A list item, plus the lines that continue it.
        m = re.match(r'^(\s*(?:[-*+]|\d+[.)])\s+)(.*)$', line) if kind == 'prose' else None
        if m and stripped:
            flush()
            marker, rest = m.group(1), m.group(2)
            # A task checkbox is part of the marker, never part of the text.
            box = re.match(r'^(\[[ xX]\]\s+)(.*)$', rest)
            if box:
                marker, rest = marker + box.group(1), box.group(2)
            item.append(rest)
            j = i + 1
            while (j < len(doc.lines) and doc.kind[j] == 'prose'
                   and doc.lines[j].strip()
                   and not re.match(r'^\s*(?:[-*+]|\d+[.)])\s', doc.lines[j])
                   and not doc.lines[j].lstrip().startswith('>')
                   and doc.lines[j].startswith(' ')):
                item.append(doc.lines[j].strip())
                j += 1
            flush_item()
            i = j
            continue

        plain = (kind == 'prose' and stripped
                 and not stripped.startswith(('>', '='))
                 and not line.startswith('    '))
        if plain:
            para.append(stripped)
        else:
            flush()
            out.append(line)
        i += 1
    flush()

    new = '\n'.join(out).rstrip('\n') + '\n'
    if new == doc.raw:
        return False
    _write_lf(path, new)
    return True


def write_toc(path: Path) -> bool:
    doc = Doc(path)
    rows = doc.build_toc()
    if not rows:
        return False
    bounds = doc.toc_bounds()
    block = ['## Contents', ''] + rows
    lines = list(doc.lines)
    if bounds:
        start, end = bounds
        while end > start and not lines[end - 1].strip():
            end -= 1
        lines[start:end] = block
    else:
        # Immediately before the first section, so every kind of header
        # material above it stays together.
        first = next((i for i, lv, _ in doc.headings() if lv in (2, 3)), None)
        if first is None:
            return False
        while first and not lines[first - 1].strip():
            first -= 1
        lines[first:first] = ['', *block]
    _write_lf(path, '\n'.join(lines) + '\n')
    return True


#: A section in one of these documents is a record of what was, not live work.
DORMANT_DOCS = ('superseded', 'historical')
#: A worked example demonstrates a status line; it does not have one.
DORMANT_PATHS = (re.compile(r'(^|/)Harness/templates/'),)


def header_status(doc: 'Doc'):
    """The document status from its header block, or None when it has none."""
    for index, level, _ in doc.headings():
        if level != 1:
            continue
        j = index + 1
        while j < len(doc.lines) and not doc.lines[j].strip():
            j += 1
        if j < len(doc.lines):
            m = META_RE.match(doc.lines[j])
            if m:
                return m.group('status')
        return None
    return None


def _file_status(p: Path):
    """One document's marked sections, how many of them are dormant, and its title."""
    doc = Doc(p)
    asleep = (header_status(doc) in DORMANT_DOCS
              or any(rx.search(rel(p)) for rx in DORMANT_PATHS))
    title = next((t for _, lv, t in doc.headings() if lv == 1), rel(p))
    rows, dormant = [], 0
    for i, line in enumerate(doc.lines):
        if doc.kind[i] != 'prose' or not line.strip():
            continue
        if not doc.opens_section(i):
            continue
        m = SECTION_STATUS_RE.match(line.strip())
        if not m or m.group('status') not in SECTION_STATUS:
            continue
        if asleep:
            dormant += 1
            continue
        rows.append([m.group('status'), i + 1, doc.heading_above(i) or title])
    return rows, dormant, title


def _parser_id() -> str:
    """This file's own bytes: a memo written by a different md-format is somebody else's parse."""
    try:
        return hashlib.sha1(Path(__file__).read_bytes()).hexdigest()
    except OSError:
        return ''


def _memo_load(memo: Path) -> dict:
    try:
        data = json.loads(memo.read_text(encoding='utf-8'))
        if data['parser'] == _parser_id() and isinstance(data['files'], dict):
            return data['files']
    except (OSError, ValueError, KeyError, TypeError):
        pass
    return {}


def _memo_save(memo: Path, files: dict) -> None:
    """Whole, or not at all: two sessions may finish at once, and a half-written memo is junk."""
    scratch = memo.with_name('%s.%d.tmp' % (memo.name, os.getpid()))
    try:
        scratch.write_text(json.dumps({'parser': _parser_id(), 'files': files},
                                      ensure_ascii=False), encoding='utf-8')
        os.replace(scratch, memo)
    except OSError:
        try:
            scratch.unlink()
        except OSError:
            pass


def status_rows(paths: list[Path], memo: Path = None):
    """Every marked section, a count of the ones that are not live, and each title.

    A superseded document's `open` section was either carried into its
    successor or closed, and a template's status line is a demonstration. Both
    used to sit in the workspace map as live work: the template's example
    showed as an open item from the day the format was written. They are
    counted rather than silently dropped, because a map that hides things
    without saying so is how the checks in this workspace went wrong before.

    With a memo, a file whose size and modification time have not moved is not
    read again. The prompt hook asks for this index on every prompt, and parsing
    1,134 documents each time took 1.7 s on 2026-09-22. Without one — the default
    — nothing is written anywhere.
    """
    rows: list[tuple[str, str, int, str]] = []
    titles: dict[str, str] = {}
    dormant = 0
    kept = _memo_load(memo) if memo else {}
    fresh: dict = {}
    for p in paths:
        name = rel(p)
        entry = None
        if memo:
            try:
                stat = p.stat()
                stamp = [stat.st_mtime_ns, stat.st_size]
            except OSError:
                stamp = None
            entry = kept.get(name)
            if not (stamp and isinstance(entry, dict) and entry.get('stamp') == stamp):
                entry = None
        if entry is None:
            found, asleep, title = _file_status(p)
            entry = {'rows': found, 'dormant': asleep, 'title': title}
            if memo and stamp:
                entry['stamp'] = stamp
        fresh[name] = entry
        dormant += entry['dormant']
        titles[name] = entry['title']
        rows.extend((status, name, line, heading) for status, line, heading in entry['rows'])
    if memo and fresh != kept:
        _memo_save(memo, fresh)
    return rows, dormant, titles


def status_json(paths: list[Path], memo: Path = None, absent: int = 0) -> int:
    """The same index as a machine can read it. task-recall is the caller.

    One parser of the house format, not two: task-recall asks for this rather than
    reading the printed table, so a change to a section's shape reaches both.
    """
    rows, dormant, titles = status_rows(paths, memo)
    live = ('open', 'blocked', 'needs-owner')
    print(json.dumps({
        'sections': [{'status': s, 'file': f, 'line': n, 'heading': h,
                      'live': s in live} for s, f, n, h in rows],
        # Every file considered, not only those carrying a status: task-recall needs
        # the same notion of "ours" this tool applies, and a second copy of that
        # rule is a copy that drifts.
        'files': [rel(p) for p in paths if not not_ours(p)],
        # The H1 of each, so a caller that matches on names need not open a file.
        'titles': titles,
        'counts': {'marked': len(rows), 'live': sum(1 for r in rows if r[0] in live),
                   'dormant': dormant, 'absent': absent},
    }, indent=2, ensure_ascii=False))
    return 0


def status_index(paths: list[Path], absent: int = 0) -> int:
    rows, dormant, _ = status_rows(paths)
    if not rows:
        print('Nothing carries a section status yet.')
        return 0
    order = {s: n for n, s in enumerate(SECTION_STATUS)}
    rows.sort(key=lambda r: (order.get(r[0], 9), r[1], r[2]))
    current = None
    for status, file, line, head in rows:
        if status != current:
            print(f'\n{status.upper()}')
            current = status
        print(f'  {file}:{line}\n      {head}')
    live = sum(1 for r in rows if r[0] in ('open', 'blocked', 'needs-owner'))
    print(f'\n{len(rows)} marked sections, {live} still live.')
    if dormant:
        print(f'{dormant} more in superseded or historical documents and '
              f'templates, not shown.')
    if absent:
        print(f'{absent} tracked document{"s" if absent != 1 else ""} not readable on '
              f'this device (a symlink into a runtime bootstrap has not built).')
    return 0


GOOD_HEAD = ('# A title that states the conclusion\n\n'
             '> **2026-09-11** · Peter · `current`\n>\n'
             '> First sentence. Second sentence.\n')


def selftest() -> int:
    """Every rule, fired and not fired. Each case is a defect found in build."""
    global ROOT  # the always-on cases swap it for a temporary root
    import tempfile

    def codes(body: str, name: str = 'doc.md') -> set:
        with tempfile.TemporaryDirectory() as d:
            p = Path(d) / name
            p.write_text(body, encoding='utf-8')
            return {line.split(': ')[1].split(' ')[0] for line in check(p)}

    def messages(body: str, name: str = 'doc.md') -> list:
        with tempfile.TemporaryDirectory() as d:
            p = Path(d) / name
            p.write_text(body, encoding='utf-8')
            return list(check(p))

    cases: list[tuple[str, bool, str]] = []

    def expect(label: str, ok: bool):
        cases.append((label, ok, ''))

    h = GOOD_HEAD
    # the template and a well-formed document raise nothing
    expect('clean document is silent', codes(h + '\n## A claim\n\nBody.\n') == set())
    expect('template passes its own rule',
           not check(ROOT / 'Harness/templates/markdown-doc.md'))

    # title and header block
    expect('E001 no title', 'E001' in codes('Body only.\n'))
    expect('E001 two titles', 'E001' in codes(h + '\n# Second\n'))
    expect('E003 missing header', 'E003' in codes('# T\n\nBody.\n'))
    expect('E004 malformed header',
           'E004' in codes('# T\n\n> 2026-09-11 Peter current\n>\n> One. Two.\n'))
    expect('E005 bad doc status',
           'E005' in codes('# T\n\n> **2026-09-11** · Peter · `wat`\n>\n> One. Two.\n'))
    expect('E006 one-sentence summary',
           'E006' in codes('# T\n\n> **2026-09-11** · Peter · `current`\n>\n> Only one.\n'))
    expect('front matter may precede the title',
           'E001' not in codes('---\nname: x\n---\n' + h))
    expect('HTML comment may precede the title',
           'E001' not in codes('<!-- profile\nk: v\n-->\n' + h))

    # headings
    expect('E007 skipped level', 'E007' in codes(h + '\n#### Too deep\n\nx.\n'))
    expect('E002 setext heading', 'E002' in codes('Underlined\n==========\n\nx.\n'))
    expect('a fence hides a fake heading',
           codes(h + '\n## S\n\n```\n# not a heading\n```\n') == set())

    # width, measured on what a reader sees
    expect('E008 long prose', 'E008' in codes(h + '\n## S\n\n' + 'w ' * 45 + '\n'))
    expect('a long link target does not count',
           'E008' not in codes(h + '\n## S\n\n- [short text](#' + 'a' * 120 + ')\n'))
    expect('a bare URL does not count',
           'E008' not in codes(h + '\n## S\n\nSee https://e.com/' + 'p' * 120 + '\n'))
    expect('the blockquote marker does not count',
           'E008' not in codes(h + '\n## S\n\n> ' + 'w' * 79 + '\n'))
    expect('a long backticked path does not count',
           'E008' not in codes(h + '\n## S\n\nSee `' + 'a/' * 60 + 'x.md` for it.\n'))
    expect('a short backticked word still counts',
           'E008' in codes(h + '\n## S\n\n' + 'w ' * 40 + '`tok` ' + 'w ' * 6 + '\n'))
    expect('a too-wide heading is told to shorten, not wrap',
           any('shorten this heading' in m
               for m in messages(h + '\n## ' + 'Heading words ' * 8 + '\n\nBody.\n')))

    # section status
    expect('E011 unknown status', 'E011' in codes(h + '\n## S\n\n`wat` · x\n'))
    expect('every vocabulary word is accepted',
           all('E011' not in codes(f'{h}\n## S\n\n`{s}` · x\n') for s in SECTION_STATUS))
    def rows_of(body: str, name: str = 'doc.md'):
        with tempfile.TemporaryDirectory() as d:
            p = Path(d) / name
            p.parent.mkdir(parents=True, exist_ok=True)
            p.write_text(body, encoding='utf-8')
            return status_rows([p])[:2]      # rows and the dormant count; titles are tested apart

    live_doc = h + '\n## A claim\n\n`open` · still to do\n\nBody.\n'
    live_rows, live_dormant = rows_of(live_doc)
    expect('an open section in a current document is live',
           live_dormant == 0 and [(r[0], r[3]) for r in live_rows] == [('open', 'A claim')])
    expect('an open section in a superseded document is not live',
           rows_of(live_doc.replace('`current`', '`superseded`')) == ([], 1))
    expect('an open section in a historical document is not live',
           rows_of(live_doc.replace('`current`', '`historical`')) == ([], 1))
    expect("a template's example status is not live",
           rows_of(live_doc, 'Harness/templates/markdown-doc.md') == ([], 1))

    expect('a doc status is not a section status',
           'E011' in codes(h + '\n## S\n\n`current` · x\n'))
    expect('a backticked word mid-paragraph is not a status',
           'E011' not in codes(h + '\n## S\n\nText.\n\n`wat` and more.\n'))

    # tables
    expect('E015 ragged table',
           'E015' in codes(h + '\n## S\n\n| a | b |\n| --- | --- |\n| 1 | 2 | 3 |\n'))
    expect('an escaped pipe is not a column',
           'E015' not in codes(h + '\n## S\n\n| a | b |\n| --- | --- |\n| `x\\|y` | 2 |\n'))
    expect('a table inside a blockquote is still a table',
           'E015' in codes(h + '\n## S\n\n> | a | b |\n> | --- | --- |\n> | 1 | 2 | 3 |\n'))

    # alerts, whitespace, links
    expect('E012 two alerts',
           'E012' in codes(h + '\n## S\n\n> [!NOTE]\n> a\n\n> [!WARNING]\n> b\n'))
    expect('one alert is fine',
           'E012' not in codes(h + '\n## S\n\n> [!WARNING]\n> a\n'))
    expect('E014 trailing space', 'E014' in codes(h + '\n## S\n\nBody. \n'))
    expect('E014 no final newline', 'E014' in codes(h.rstrip('\n')))
    expect('E013 dead relative link',
           'E013' in codes(h + '\n## S\n\n[x](./nope.md)\n'))
    expect('an external link is not resolved',
           'E013' not in codes(h + '\n## S\n\n[x](https://example.com)\n'))

    # exemptions
    expect('SKILL.md waives the header block',
           'E003' not in codes('---\nname: s\n---\n# T\n\nBody.\n', 'SKILL.md'))
    expect('SKILL.md still obeys width',
           'E008' in codes('---\nname: s\n---\n# T\n\n' + 'w ' * 45 + '\n', 'SKILL.md'))
    long_doc = h + '\n## S\n\n' + 'Line.\n\n' * TOC_MIN_LINES
    stale_doc = h + '\n## Contents\n\n- [Gone](#gone)\n\n## S\n\n' + 'Line.\n\n' * TOC_MIN_LINES
    saved_root = ROOT
    with tempfile.TemporaryDirectory() as d:
        ROOT = Path(d).absolute()  # rel() names each case's path from this root

        def at(name: str, body: str) -> set:
            p = ROOT / name
            p.parent.mkdir(parents=True, exist_ok=True)
            p.write_text(body, encoding='utf-8')
            return {line.split(': ')[1].split(' ')[0] for line in check(p)}
        try:
            for name in sorted(ALWAYS_ON):
                expect(f'a long always-on {name} needs no Contents', 'E009' not in at(name, long_doc))
            expect('an always-on note keeps its stale-Contents check', 'E010' in at('CLAUDE.md', stale_doc))
            expect('an on-demand folder note still needs Contents',
                   'E009' in at('Harness/CLAUDE.md', long_doc))
            expect('any other long document still needs Contents', 'E009' in at('notes.md', long_doc))
        finally:
            ROOT = saved_root

    # Contents
    with tempfile.TemporaryDirectory() as d:
        p = Path(d) / 'long.md'
        p.write_text(h + '\n## Same\n\nx.\n\n### Deep\n\ny.\n\n## Same\n\nz.\n'
                     + '\nfiller\n' * TOC_MIN_LINES, encoding='utf-8')
        write_toc(p)
        first = p.read_text(encoding='utf-8')
        expect('Contents lists H3 indented', '  - [Deep](#deep)' in first)
        expect('duplicate anchors are numbered', '(#same-1)' in first)
        write_toc(p)
        expect('toc is idempotent', p.read_text(encoding='utf-8') == first)
        expect('a fresh Contents is not stale', 'E010' not in
               {line.split(': ')[1].split(' ')[0] for line in check(p)})

    # rewrap: the destructive one, so every structure it must not touch is a
    # case here. The front-matter case is a real incident, not a hypothetical.
    def after_rewrap(body: str) -> str:
        with tempfile.TemporaryDirectory() as d:
            p = Path(d) / 'r.md'
            p.write_text(body, encoding='utf-8')
            rewrap(p)
            return p.read_text(encoding='utf-8')

    long_yaml = ('---\nname: s\ndescription: ' + 'word ' * 40 + '\n---\n'
                 + '# T\n\nShort.\n')
    expect('rewrap leaves YAML front matter on one line',
           'description: ' + 'word ' * 40 in after_rewrap(long_yaml))
    expect('rewrap wraps a long paragraph',
           all(len(l) <= WIDTH for l in
               after_rewrap(h + '\n## S\n\n' + 'word ' * 60 + '\n').split('\n')))
    expect('rewrap leaves a fence alone',
           '    indented  code   line' in
           after_rewrap(h + '\n## S\n\n```\n    indented  code   line\n```\n'))
    expect('rewrap leaves a table alone',
           '| a | b |' in after_rewrap(h + '\n## S\n\n| a | b |\n| --- | --- |\n'))
    expect('rewrap leaves a blockquote alone',
           after_rewrap(h + '\n## S\n\n> quoted\n').count('> quoted') == 1)
    expect('rewrap keeps short list items on one line',
           after_rewrap(h + '\n## S\n\n- one\n- two\n').count('\n- ') == 2)
    expect('rewrap hangs a long list item under its marker',
           after_rewrap(h + '\n## S\n\n- ' + 'word ' * 40 + '\n')
           .split('\n## S\n\n')[1].split('\n')[1].startswith('  word'))
    expect('a task checkbox survives',
           after_rewrap(h + '\n## S\n\n- [ ] ' + 'word ' * 40 + '\n')
           .count('- [ ] word') == 1)
    expect('a numbered item keeps its number and indent',
           after_rewrap(h + '\n## S\n\n1. ' + 'word ' * 40 + '\n')
           .split('\n## S\n\n')[1].split('\n')[1].startswith('   word'))
    expect('a nested list keeps its depth',
           '\n  - inner' in after_rewrap(h + '\n## S\n\n- outer\n  - inner\n'))
    expect('rewrap keeps the header block intact',
           '> **2026-09-11** · Peter · `current`' in after_rewrap(h + '\n## S\n\nx.\n'))
    # A Contents entry is long in bytes and short to a reader. Wrapping one
    # splits the link across lines and makes the Contents read as stale.
    toc_line = ('- [A heading long enough to matter here](#a-heading-long-'
                'enough-to-matter-here)')
    expect('rewrap leaves a Contents entry on one line',
           toc_line in after_rewrap(h + '\n## Contents\n\n' + toc_line + '\n'))
    expect('rewrap never changes the words',
           re.findall(r'\w+', after_rewrap(h + '\n## S\n\n' + 'word ' * 60 + '\n'))
           == re.findall(r'\w+', h + '\n## S\n\n' + 'word ' * 60 + '\n'))
    expect('rewrap is idempotent',
           after_rewrap(after_rewrap(h + '\n## S\n\n' + 'word ' * 60 + '\n'))
           == after_rewrap(h + '\n## S\n\n' + 'word ' * 60 + '\n'))

    failed = [label for label, ok, _ in cases if not ok]
    for label, ok, _ in cases:
        print(f'  {"ok  " if ok else "FAIL"}  {label}')
    print(f'\n{len(cases)} checks, {len(failed)} failed')
    return 1 if failed else 0


#: A sentence carrying one of these is stating a rule, not describing one.
MODAL = re.compile(r'\b(must|never|always|do not|cannot|refuses?|forbidden|required)\b',
                   re.IGNORECASE)
#: Parallel per-folder notes repeat their own boilerplate on purpose.
BOILERPLATE = re.compile(r'(^|/)(AGENTS|README)\.md$')
#: A version marker in a filename: V5 vs V6, v3.1, revision-2, 2026-09-08.
REVISION = re.compile(
    r'(?:^|[_\- ])(?:v(?:er(?:sion)?)?[ _\-]?\d+(?:\.\d+)*|r(?:ev(?:ision)?)[ _\-]?\d+'
    r'|\d{4}-\d{2}-\d{2})(?=$|[_\- ])', re.IGNORECASE)


def revision_family(name: str) -> str:
    """A document and its own superseded revisions share one family.

    V6 is V5 with amendments and no inherited sentence reworded — that is the
    design, and the byte-identical text between them is not two places stating
    one rule. Without this the check reported 92 duplications, 90 of them a
    specification agreeing with its own previous edition, and a check nobody
    will run is worse than no check.
    """
    stem = Path(name)
    return str(stem.parent) + '/' + REVISION.sub('', stem.stem).strip('_- ').lower()


def duplicate_rules(paths: list[Path]) -> int:
    """Report a normative sentence that appears in more than one document.

    The router states the rule this enforces: "Where you find the same rule
    twice, the copy outside this file is the one that drifts." A routing table
    sat in three files until 2026-09-11 and had already lost two entries, and
    the bilingual-HTML rule sat in three until this check found it — the copy
    in a folder note had already decayed to weaker wording than the one in
    Claude/REMINDERS.md.

    Deliberately narrow. Only sentences long enough to be a rule rather than a
    heading, only ones carrying a modal, and never the parallel AGENTS.md and
    README.md notes, whose shared boilerplate is the point of them.
    """
    seen: dict[str, set[str]] = {}
    for path in paths:
        if not_ours(path) or BOILERPLATE.search(rel(path)):
            continue
        try:
            body = re.sub(r'```.*?```', '', path.read_text(encoding='utf-8'), flags=re.S)
        except (OSError, UnicodeDecodeError):
            continue
        for raw in re.split(r'(?<=[.!?])\s+', body):
            sentence = ' '.join(raw.split())
            if not 60 <= len(sentence) <= 320 or not MODAL.search(sentence):
                continue
            key = re.sub(r'[`*_\[\]()]', '', sentence)
            seen.setdefault(key, set()).add(rel(path))
    dupes = {k: v for k, v in seen.items()
             if len({revision_family(f) for f in v}) > 1}
    for sentence, files in sorted(dupes.items(), key=lambda kv: -len(kv[1])):
        print(f'{len(files)} documents state the same rule:')
        for name in sorted(files):
            print(f'    {name}')
        print(f'    “{sentence[:150]}”')
    total = len(dupes)
    print(f'\n{len(paths)} files, {total} rule{"" if total == 1 else "s"} stated more than once')
    return 1 if total else 0


def main() -> int:
    ap = argparse.ArgumentParser(prog='md-format', description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest='cmd', required=True)
    for name, helptext in (('check', 'check the house format'),
                           ('status', 'index every marked section'),
                           ('toc', 'insert or refresh Contents'),
                           ('fix', 'repair trailing whitespace and final newline'),
                           ('rewrap', 'rewrap plain prose paragraphs to 80'),
                           ('dupes', 'find a rule stated in more than one document'),
                           ('selftest', 'run the rule against its own fixtures')):
        p = sub.add_parser(name, help=helptext)
        p.add_argument('paths', nargs='*', type=Path)
        if name == 'status':
            p.add_argument('--json', action='store_true',
                           help='the same index, machine-readable')
            p.add_argument('--memo', type=Path,
                           help='with --json: keep each unchanged file\'s sections here '
                                'instead of reading it again (the prompt hook\'s; off by default)')
        if name == 'check':
            p.add_argument('--all', action='store_true',
                           help='every tracked .md (the default with no paths)')
            p.add_argument('-q', '--quiet', action='store_true',
                           help='print the count only')
    args = ap.parse_args()

    if args.cmd == 'selftest':
        return selftest()

    paths = [p for p in (args.paths or []) if p.suffix == '.md' and p.is_file()]
    for p in (args.paths or []):
        if p.is_dir():
            paths.extend(sorted(p.rglob('*.md')))
    if not paths:
        if args.cmd in ('toc', 'fix', 'rewrap'):
            ap.error(f'{args.cmd} needs a file')
        # Run inside another repository, it checks that one's files, as i18n does.
        here = subprocess.run(['git', 'rev-parse', '--show-toplevel'], capture_output=True,
                              text=True).stdout.strip()
        other = here and Path(here).resolve() != ROOT.resolve()
        paths = _listed_markdown(Path(here)) if other else tracked_markdown()
    # Ten tracked .md files are symlinks into a runtime that bootstrap builds, so
    # on a device that has not built it yet they are entries with nothing behind
    # them. Counted, never fatal: the first one stopped `status` with a traceback
    # on 2026-09-22, which is how the prompt hook went silent for a whole session.
    absent = sum(1 for p in paths if not p.is_file())
    paths = [p for p in paths if p.is_file()]

    if args.cmd == 'status':
        return status_json(paths, args.memo, absent) if args.json else status_index(paths, absent)
    if args.cmd == 'dupes':
        return duplicate_rules(paths)
    if args.cmd == 'toc':
        for p in paths:
            print(f'{"refreshed" if write_toc(p) else "no headings in"} {rel(p)}')
        return 0
    if args.cmd == 'fix':
        for p in paths:
            print(f'{"fixed" if fix(p) else "clean"} {rel(p)}')
        return 0
    if args.cmd == 'rewrap':
        for p in paths:
            print(f'{"rewrapped" if rewrap(p) else "unchanged"} {rel(p)}')
        return 0

    skipped = [p for p in paths if not_ours(p)]
    paths = [p for p in paths if p not in skipped]
    problems, bad_files = [], 0
    for p in paths:
        found = check(p)
        if found:
            bad_files += 1
            problems.extend(found)
    if not args.quiet:
        for line in problems:
            print(line)
        if problems:
            print()
    tail = f', {len(skipped)} skipped as not ours' if skipped else ''
    tail += f', {absent} absent on this device' if absent else ''
    print(f'{len(paths)} files, {bad_files} with problems, '
          f'{len(problems)} problems{tail}')
    return 1 if problems else 0


if __name__ == '__main__':
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
