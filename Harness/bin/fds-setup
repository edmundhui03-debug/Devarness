#!/usr/bin/env python3
"""Install pinned NIST FDS + Smokeview in the ignored dev runtime, then prove it.

PyroSim is Windows-only; this is the Mac-side solver that runs the dev PyroSim
guide's reference cases. --install verifies the official macOS installer by
SHA-256, extracts its embedded tarball without running the installer (so no
shell startup file is edited), and writes fds, smokeview and fds-mpiexec
wrappers into ~/.local/bin only where no foreign file already exists.
--check changes nothing outside a temporary directory: it requires a managed
install and a tiny propane fire that runs to FDS's own success line.
"""

import argparse
import hashlib
import io
import json
import os
from pathlib import Path
import platform
import shlex
import shutil
import subprocess
import sys
import tarfile
import tempfile


VERSION = "6.10.1"
SHA256 = "ce23aac57be5f3bcab420a541f01b02a8ac084ae9ea5d479129711c8c23ddaaa"
URL = ("https://github.com/firemodels/fds/releases/download/FDS-6.10.1/"
       "FDS-6.10.1_SMV-6.10.1_osx.sh")
MARKER = b"\n__TARFILE_FOLLOWS__\n"
ROOT = Path(__file__).resolve().parents[2]
PREFIX = ROOT / "Harness" / ".runtime" / "fds" / VERSION
LINKS = Path.home() / ".local" / "bin"
WRAPPER_TAG = "# fds-setup wrapper"
WRAPPERS = {"fds": "bin/fds", "smokeview": "smvbin/smokeview",
            "fds-mpiexec": "bin/openmpi_64/bin/mpiexec"}
SUCCESS = "STOP: FDS completed successfully"
PROBE_CASE = """&HEAD CHID='probe', TITLE='dev FDS readiness probe' /
&MESH IJK=12,12,12, XB=0.0,1.2,0.0,1.2,0.0,1.2 /
&TIME T_END=2.0 /
&REAC FUEL='PROPANE' /
&SURF ID='BURNER', HRRPUA=500.0 /
&OBST XB=0.5,0.7,0.5,0.7,0.0,0.1, SURF_IDS='BURNER','INERT','INERT' /
&VENT MB='ZMAX', SURF_ID='OPEN' /
&DEVC ID='T_PLUME', QUANTITY='TEMPERATURE', XYZ=0.6,0.6,1.0 /
&TAIL /
"""


def sha256_of(path):
    digest = hashlib.sha256()
    with open(path, "rb") as stream:
        for block in iter(lambda: stream.read(1 << 20), b""):
            digest.update(block)
    return digest.hexdigest()


def inside(base, candidate):
    return candidate == base or base in candidate.parents


def validate_members(package, stage):
    """Refuse links out of the stage, absolute names and special files."""
    for member in package.getmembers():
        destination = (stage / member.name).resolve()
        if not inside(stage, destination) or not (member.isfile() or member.isdir() or member.issym()):
            raise RuntimeError("Unsafe installer entry: " + member.name)
        if member.issym():
            target = (destination.parent / member.linkname).resolve()
            if os.path.isabs(member.linkname) or not inside(stage, target):
                raise RuntimeError("Unsafe installer link: " + member.name + " -> " + member.linkname)


def extract(installer, prefix=PREFIX, expected=SHA256):
    """Verify, extract to a sibling stage, then publish by one rename."""
    installer, prefix = Path(installer), Path(prefix)
    actual = sha256_of(installer)
    if actual != expected:
        raise RuntimeError("SHA-256 mismatch: installer rejected (" + actual + ")")
    if os.path.lexists(prefix):
        raise RuntimeError("Runtime prefix already exists; inspect it first: " + str(prefix))
    data = installer.read_bytes()
    start = data.find(MARKER)
    if start < 0:
        raise RuntimeError("No embedded tarball marker in installer")
    prefix.parent.mkdir(parents=True, exist_ok=True)
    stage = Path(tempfile.mkdtemp(prefix="." + prefix.name + ".stage-", dir=prefix.parent)).resolve()
    try:
        with tarfile.open(fileobj=io.BytesIO(data[start + len(MARKER):]), mode="r:gz") as package:
            validate_members(package, stage)
            if hasattr(tarfile, "data_filter"):
                package.extractall(stage, filter="data")
            else:
                package.extractall(stage)
        for relative in ("bin/fds", "smvbin/smokeview"):
            if not (stage / relative).is_file():
                raise RuntimeError("Installer did not contain " + relative)
        (stage / "install.json").write_text(json.dumps({
            "version": VERSION, "installer_sha256": expected, "source_url": URL,
            "installer_name": installer.name}, indent=2) + "\n")
        os.rename(stage, prefix)
    except BaseException:
        shutil.rmtree(stage, ignore_errors=True)
        raise


def environment(prefix):
    """The variables NIST's FDS6VARS.sh sets for the bundled binaries."""
    env = dict(os.environ)
    env["PATH"] = os.pathsep.join([str(prefix / "bin"), str(prefix / "bin/openmpi_64/bin"),
                                   str(prefix / "smvbin"), env.get("PATH", os.defpath)])
    env["OPAL_PREFIX"] = str(prefix / "bin/openmpi_64")
    env["TMPDIR"] = "/tmp"  # Open MPI socket paths overflow under long temp dirs
    env.setdefault("OMP_NUM_THREADS", "4")
    return env


def wrapper_text(prefix, relative):
    root = shlex.quote(str(prefix))
    return ("#!/bin/sh\n"
            + WRAPPER_TAG + " for FDS " + VERSION + "; regenerate with Harness/bin/fds-setup --install\n"
            + "FDS_ROOT=" + root + "\n"
            + 'PATH="$FDS_ROOT/bin:$FDS_ROOT/bin/openmpi_64/bin:$FDS_ROOT/smvbin:$PATH"\n'
            + 'OPAL_PREFIX="$FDS_ROOT/bin/openmpi_64"\n'
            + "TMPDIR=/tmp\n"
            + ': "${OMP_NUM_THREADS:=4}"\n'
            + "export PATH OPAL_PREFIX TMPDIR OMP_NUM_THREADS\n"
            + 'exec "$FDS_ROOT/' + relative + '" "$@"\n')


def write_wrapper(links, name, text):
    path = Path(links) / name
    if os.path.lexists(path):
        try:
            ours = path.is_file() and not path.is_symlink() and WRAPPER_TAG in path.read_text()
        except (OSError, UnicodeDecodeError):
            ours = False
        if not ours:
            return "existing path preserved; not ours"
        path.write_text(text)
        return "refreshed"
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(text)
    path.chmod(0o755)
    return "created"


def completed_install(prefix, expected):
    record_path = Path(prefix) / "install.json"
    try:
        record = json.loads(record_path.read_text())
    except (OSError, ValueError) as error:
        raise RuntimeError("Runtime is missing or unmanaged (no readable install.json): " + str(prefix)) from error
    if record.get("version") != VERSION or record.get("installer_sha256") != expected:
        raise RuntimeError("Runtime is unmanaged or out of date: install.json does not match the pin")


def check(prefix=PREFIX, expected=SHA256):
    """Run a 2-second propane fire and require FDS's own success line."""
    prefix = Path(prefix)
    completed_install(prefix, expected)
    with tempfile.TemporaryDirectory(prefix="fds-probe-", dir="/tmp") as temp:
        (Path(temp) / "probe.fds").write_text(PROBE_CASE)
        result = subprocess.run([str(prefix / "bin" / "fds"), "probe.fds"], cwd=temp,
                                env=environment(prefix), capture_output=True, text=True,
                                timeout=600)
        out_file = Path(temp) / "probe.out"
        log = result.stdout + result.stderr + (out_file.read_text(errors="replace") if out_file.is_file() else "")
    if SUCCESS not in log:
        tail = "\n".join(log.strip().splitlines()[-15:])
        raise RuntimeError("FDS did not complete the probe fire (exit " + str(result.returncode) + "):\n" + tail)
    version = next((line.strip() for line in log.splitlines() if "Revision" in line or "FDS-" in line), "")
    return {"status": "ready", "version": VERSION, "revision_line": version,
            "binary": str(prefix / "bin" / "fds"), "installer_sha256": expected,
            "source_url": URL, "architecture": platform.machine()}


def install(installer_path=None):
    if platform.system() != "Darwin":
        raise RuntimeError("This installer uses NIST's macOS build and is verified only on macOS")
    PREFIX.parent.mkdir(parents=True, exist_ok=True)
    lock = PREFIX.parent / ("." + VERSION + ".install.lock")
    try:
        lock.mkdir()
    except FileExistsError as error:
        raise RuntimeError("Install lock exists; inspect its owner before retrying: " + str(lock)) from error
    try:
        if not (PREFIX / "bin" / "fds").is_file():
            with tempfile.TemporaryDirectory(prefix="fds-download-") as temp:
                installer = Path(installer_path) if installer_path else Path(temp) / Path(URL).name
                if not installer_path:
                    subprocess.run(["curl", "--fail", "--location", "--proto", "=https",
                                    "--proto-redir", "=https", "--tlsv1.2", "--retry", "2",
                                    "--connect-timeout", "15", "--output", str(installer), URL],
                                   check=True)
                extract(installer, PREFIX, SHA256)
        report = check(PREFIX, SHA256)
        report["wrappers"] = {name: write_wrapper(LINKS, name, wrapper_text(PREFIX, relative))
                              for name, relative in WRAPPERS.items()}
        return report
    finally:
        lock.rmdir()


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    mode = parser.add_mutually_exclusive_group(required=True)
    mode.add_argument("--check", action="store_true", help="prove the managed runtime computes a fire")
    mode.add_argument("--install", action="store_true", help="install the pinned runtime and wrappers")
    parser.add_argument("--installer", help="use an already-downloaded installer (still SHA-256 verified)")
    args = parser.parse_args(argv)
    try:
        report = check() if args.check else install(args.installer)
    except (RuntimeError, OSError, subprocess.SubprocessError) as error:
        print("fds-setup: " + str(error), file=sys.stderr)
        return 1
    print(json.dumps(report, indent=2))
    return 0


if __name__ == "__main__":
    sys.exit(main())
