#!/usr/bin/env python3
"""rea — run REA's CLI and stdio MCP server from the local runtime, nothing global, no console pop-up.

  rea mcp                 the stdio MCP server bootstrap registers at user level (Claude Code, Codex)
  rea --version           prints REA's version (expect 4.1.0)
  rea doctor --provider ghidra --json
  rea inspect <file> --provider ghidra --format json

It builds the child environment with GHIDRA_INSTALL_DIR, JAVA_HOME,
REA_ANALYSIS_PROVIDER=ghidra, PATH with the local Node, the JDK bin and Ghidra support prepended for
the child only, and npm cache inside Harness/.runtime. It runs
`node Harness/.runtime/rea/node_modules/rea-agents/scripts/rea.mjs <args>` with inherited stdio,
returning the child's exit code. It prints NOTHING to its own stdout (MCP speaks over stdout). If the
runtime is not installed it prints one line to stderr naming the installer and exits 3.

The dev root is derived from this file's own location, so no machine path is tracked. Two env overrides
exist for tests and relocation: DEVARNESS_REVERSE_RUNTIME (the runtime root) and DEVARNESS_REVERSE_NODE (the node
binary). REA keeps its state in ~/.rea; a caller that must contain that sets HOME/USERPROFILE itself.
"""
import os
from pathlib import Path
import subprocess
import sys

LIBRARY = Path(__file__).resolve().parents[1]


def runtime_root():
    env = os.environ.get("DEVARNESS_REVERSE_RUNTIME")
    return Path(env) if env else LIBRARY / ".runtime"


def _first(base, patterns):
    for pat in patterns:
        hits = sorted(Path(base).glob(pat))
        if hits:
            return hits[0]
    return None


def resolve(root=None):
    """Resolve the runtime's pieces. Returns a dict with whatever is present (value None if missing)."""
    root = Path(root) if root is not None else runtime_root()
    node_env = os.environ.get("DEVARNESS_REVERSE_NODE")
    node = Path(node_env) if node_env else _first(root / "node", ["node.exe", "*/node.exe", "bin/node", "node"])
    java = _first(root / "jdk", ["bin/java.exe", "*/bin/java.exe", "bin/java", "*/bin/java"])
    headless = _first(root / "ghidra", ["support/analyzeHeadless.bat", "*/support/analyzeHeadless.bat",
                                        "support/analyzeHeadless", "*/support/analyzeHeadless"])
    jadx = _first(root / "jadx", ["bin/jadx.bat", "*/bin/jadx.bat", "bin/jadx", "*/bin/jadx"])
    apktool_jar = (root / "apktool" / "apktool.jar")
    rea = root / "rea" / "node_modules" / "rea-agents" / "scripts" / "rea.mjs"
    return {
        "root": root,
        "node": node if (node and node.exists()) else None,
        "java": java,
        "java_home": java.parent.parent if java else None,
        "ghidra_headless": headless,
        "ghidra_dir": headless.parent.parent if headless else None,
        "jadx": jadx,
        "apktool_jar": apktool_jar if apktool_jar.is_file() else None,
        "rea": rea if rea.is_file() else None,
    }


def build_env(parts, extra_path=()):
    """The child environment from RECIPE section 4, for the child process only."""
    env = dict(os.environ)
    path_dirs = []
    if parts.get("node"):
        path_dirs.append(str(parts["node"].parent))
    if parts.get("java"):
        path_dirs.append(str(parts["java"].parent))
    if parts.get("ghidra_headless"):
        path_dirs.append(str(parts["ghidra_headless"].parent))
    path_dirs.extend(str(p) for p in extra_path)
    env["PATH"] = os.pathsep.join(path_dirs + [env.get("PATH", "")])
    if parts.get("ghidra_dir"):
        env["GHIDRA_INSTALL_DIR"] = str(parts["ghidra_dir"])
    if parts.get("java_home"):
        env["JAVA_HOME"] = str(parts["java_home"])
    env["REA_ANALYSIS_PROVIDER"] = "ghidra"
    env["npm_config_cache"] = str(parts["root"] / "npm-cache")
    env["npm_config_update_notifier"] = "false"
    return env


def run_child(cmd, env):
    # Inherit the host's stdin/stdout/stderr unchanged: the MCP host speaks JSON-RPC over them, so
    # the launcher must add nothing of its own. No new-console flag is passed (CREATE_NO_WINDOW would
    # also break inherited pipe output); STARTF_USESHOWWINDOW with the default SW_HIDE merely hides a
    # console the child might allocate when the host has none, without touching the inherited handles.
    kw = {"stdin": None, "stdout": None, "stderr": None, "env": env}
    if os.name == "nt":
        si = subprocess.STARTUPINFO()
        si.dwFlags |= subprocess.STARTF_USESHOWWINDOW
        kw["startupinfo"] = si
    return subprocess.run(cmd, **kw).returncode


def main(argv=None):
    args = list(sys.argv[1:] if argv is None else argv)
    parts = resolve()
    if not parts["node"] or not parts["rea"]:
        sys.stderr.write("rea: the REA runtime is not installed; "
                         "run 'python %s --from <dir>' first\n" % (LIBRARY / "setup-reverse.py").as_posix())
        return 3
    env = build_env(parts)
    return run_child([str(parts["node"]), str(parts["rea"]), *args], env)


if __name__ == "__main__":
    sys.exit(main())
